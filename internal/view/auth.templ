package view

templ field(label, name, typ, value, autocomplete string, required bool) {
	<label class="rh-field">
		<span class="rh-label">{ label }</span>
		<input class="rh-input" type={ typ } name={ name } value={ value } autocomplete={ autocomplete } required?={ required }/>
	</label>
}

type AuthForm struct {
	Name    string
	Email   string
	Invite  string
	Errors  []string
}

templ LoginPage(f AuthForm) {
	@Bare("Sign in") {
		<section class="rh-card space-y-4">
			<div>
				<h1 class="rh-h1">Sign in</h1>
				<p class="rh-sub">Plan meals, shop together, prep ahead.</p>
			</div>
			@Errors(f.Errors)
			<form method="post" action={ URL("/login") } class="space-y-4">
				@CSRFField()
				<input type="hidden" name="invite" value={ f.Invite }/>
				@field("Email", "email", "email", f.Email, "email", true)
				@field("Password", "password", "password", "", "current-password", true)
				<button class="rh-btn rh-btn-primary w-full justify-center" type="submit">Sign in</button>
			</form>
			<p class="text-center text-sm text-slate-600">
				New here? <a class="font-semibold text-primary hover:underline" href={ templ.SafeURL(Query("/register", "invite", f.Invite)) }>Create an account</a>
			</p>
		</section>
	}
}

templ RegisterPage(f AuthForm) {
	@Bare("Create account") {
		<section class="rh-card space-y-4">
			<div>
				<h1 class="rh-h1">Create account</h1>
				<p class="rh-sub">Sign in with your email. Passwords need at least 8 characters.</p>
			</div>
			@Errors(f.Errors)
			<form method="post" action={ URL("/register") } class="space-y-4">
				@CSRFField()
				<input type="hidden" name="invite" value={ f.Invite }/>
				@field("Display name", "name", "text", f.Name, "name", true)
				@field("Email", "email", "email", f.Email, "email", true)
				@field("Password", "password", "password", "", "new-password", true)
				<button class="rh-btn rh-btn-primary w-full justify-center" type="submit">Create account</button>
			</form>
			<p class="text-center text-sm text-slate-600">
				Already have an account? <a class="font-semibold text-primary hover:underline" href={ templ.SafeURL(Query("/login", "invite", f.Invite)) }>Sign in</a>
			</p>
		</section>
	}
}

type OnboardingForm struct {
	Name   string
	Code   string
	Errors []string
	HasAny bool
}

templ OnboardingPage(f OnboardingForm) {
	@Bare("Set up your household") {
		<section class="rh-card space-y-3">
			<div>
				<p class="rh-eyebrow">Welcome, { UserName(ctx) }</p>
				<h1 class="rh-h1 mt-1">Your household</h1>
				<p class="rh-sub">Create a household to plan for, or join one with an invite code.</p>
			</div>
			@Errors(f.Errors)
		</section>
		<section class="rh-card space-y-4">
			<div class="flex items-center gap-2">
				@Icon("home", 18)
				<h2 class="text-base font-semibold">Create household</h2>
			</div>
			<form method="post" action={ URL("/onboarding/create") } class="space-y-3">
				@CSRFField()
				@field("Household name", "name", "text", f.Name, "off", true)
				<p class="rh-label-hint">You become the owner. A starter food catalog is included.</p>
				<button class="rh-btn rh-btn-primary w-full justify-center" type="submit">Create household</button>
			</form>
		</section>
		<section class="rh-card space-y-4">
			<div class="flex items-center gap-2">
				@Icon("user-plus", 18)
				<h2 class="text-base font-semibold">Join with invite</h2>
			</div>
			<form method="post" action={ URL("/onboarding/join") } class="space-y-3">
				@CSRFField()
				@field("Invite code", "code", "text", f.Code, "off", true)
				<button class="rh-btn rh-btn-secondary w-full justify-center" type="submit">Join household</button>
			</form>
		</section>
		<div class="flex justify-center gap-3">
			if f.HasAny {
				<a class="rh-btn rh-btn-ghost" href={ URL("/today") }>Back to app</a>
			}
			<form method="post" action={ URL("/logout") }>
				@CSRFField()
				<button class="rh-btn rh-btn-ghost" type="submit">Sign out</button>
			</form>
		</div>
	}
}
