package view

import (
	"time"

	"github.com/icylionz/mealplanner/internal/repo/db"
	"github.com/icylionz/mealplanner/internal/service"
)

templ PrepListPage(sessions []db.ListPrepSessionsRow, today time.Time, errors []string) {
	@Shell(Meta{Title: "Prep", Active: "prep"}) {
		@PageHeader("Batch cooking", "Prep sessions", "Group foods to cook ahead and see everything you need in one place.") {
		}
		@Errors(errors)
		if IsOwner(ctx) {
			<form method="post" action={ URL("/prep") } class="rh-card rh-card-tight flex flex-wrap items-end gap-2">
				@CSRFField()
				<label class="rh-field min-w-[200px] flex-1">
					<span class="rh-label">Session name</span>
					<input class="rh-input" type="text" name="name" placeholder="Sunday batch cook" required/>
				</label>
				<label class="rh-field">
					<span class="rh-label">Date</span>
					<input class="rh-input" type="date" name="date" value={ ISODate(today) } required/>
				</label>
				<button class="rh-btn rh-btn-primary" type="submit">@Icon("plus", 16) New session</button>
			</form>
		}
		if len(sessions) == 0 {
			@Empty("chef-hat", "No prep sessions", "Create a session and add the foods you plan to cook.") {
			}
		} else {
			<div class="rh-table-wrap">
				<table class="rh-table">
					<thead><tr><th>Session</th><th>Date</th><th class="num">Foods</th></tr></thead>
					<tbody>
						for _, s := range sessions {
							<tr class="rh-row-hover">
								<td><a class="rh-accounts-name" href={ URL("/prep/" + s.ID.String()) }>{ s.Name }</a></td>
								<td class="text-slate-600">{ ShortDate(s.SessionDate) }</td>
								<td class="num">{ Itoa(int(s.FoodCount)) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

type PrepPage struct {
	D       service.PrepDetail
	Options []FoodOption
	Errors  []string
}

templ PrepDetailPage(p PrepPage) {
	{{ s := p.D.Session }}
	@Shell(Meta{Title: s.Name, Active: "prep"}) {
		<nav class="rh-crumb"><a href={ URL("/prep") }>Prep</a><span class="sep">/</span><span class="here">{ s.Name }</span></nav>
		@PageHeader(LongDate(s.SessionDate), s.Name, "") {
			<a class="rh-btn rh-btn-secondary" href={ URL("/prep/" + s.ID.String() + "/print") } hx-boost="false" target="_blank">@Icon("printer", 16) Print</a>
		}
		@Errors(p.Errors)
		<div class="grid gap-4 lg:grid-cols-[3fr_2fr]">
			<div class="space-y-4">
				<section class="rh-card space-y-3">
					<h2 class="text-base font-semibold">Foods</h2>
					if len(p.D.Foods) == 0 {
						<p class="text-sm text-slate-500">No foods yet.</p>
					}
					for _, f := range p.D.Foods {
						<div class="mp-line flex-wrap">
							<a class="min-w-[140px] flex-1 font-semibold hover:underline" href={ URL("/foods/" + f.Food.ID.String()) }>{ p.D.Catalog.Name(f.Food.ID) }</a>
							if IsOwner(ctx) {
								<form method="post" action={ URL("/prep/" + s.ID.String() + "/foods") } class="flex items-center gap-1.5">
									@CSRFField()
									<input type="hidden" name="food_id" value={ f.Food.ID.String() }/>
									<input class="rh-input w-20 py-1" type="number" step="any" min="0" name="servings" value={ Num(f.Servings) } aria-label="Servings"/>
									<button class="rh-btn rh-btn-secondary rh-btn-sm" type="submit">Set</button>
								</form>
								<form method="post" action={ URL("/prep/" + s.ID.String() + "/foods/" + f.Food.ID.String() + "/remove") }>
									@CSRFField()
									<button class="rh-btn rh-btn-ghost rh-btn-sm" type="submit" aria-label="Remove">@Icon("x", 15)</button>
								</form>
							} else {
								<span class="text-sm">{ Num(f.Servings) } servings</span>
							}
						</div>
					}
					if IsOwner(ctx) {
						<form method="post" action={ URL("/prep/" + s.ID.String() + "/foods") } class="flex flex-wrap items-end gap-2 border-t border-slate-200 pt-3">
							@CSRFField()
							<label class="rh-field min-w-[180px] flex-1">
								<span class="rh-label">Add food or recipe</span>
								<input class="rh-input" type="search" name="food_name" list="prep-foods" required autocomplete="off"/>
							</label>
							<label class="rh-field w-24">
								<span class="rh-label">Servings</span>
								<input class="rh-input" type="number" step="any" min="0" name="servings" value="4"/>
							</label>
							<button class="rh-btn rh-btn-secondary" type="submit">@Icon("plus", 16) Add</button>
							@FoodDatalist("prep-foods", p.Options)
						</form>
					}
				</section>
				for _, f := range p.D.Foods {
					@prepBreakdown(p.D, f)
				}
			</div>
			<div class="space-y-4">
				<section class="rh-card space-y-3">
					<div class="flex items-center justify-between">
						<h2 class="text-base font-semibold">All ingredients</h2>
					</div>
					@LeafTable(p.D.Aggregated)
				</section>
				if IsOwner(ctx) {
					<section class="rh-card space-y-3">
						<p class="rh-overline">Session</p>
						<form method="post" action={ URL("/prep/" + s.ID.String()) } class="space-y-3">
							@CSRFField()
							<label class="rh-field"><span class="rh-label">Name</span><input class="rh-input" type="text" name="name" value={ s.Name } required/></label>
							<label class="rh-field"><span class="rh-label">Date</span><input class="rh-input" type="date" name="date" value={ ISODate(s.SessionDate) } required/></label>
							<button class="rh-btn rh-btn-secondary" type="submit">Save</button>
						</form>
						<form method="post" action={ URL("/prep/" + s.ID.String() + "/delete") } class="border-t border-slate-200 pt-3" data-confirm="Delete this prep session?">
							@CSRFField()
							<button class="rh-btn rh-btn-danger" type="submit">@Icon("trash", 16) Delete session</button>
						</form>
					</section>
				}
			</div>
		</div>
	}
}

templ prepBreakdown(d service.PrepDetail, f service.PrepFood) {
	<section class="rh-card space-y-3 mp-break">
		<div class="flex items-center justify-between gap-2">
			<h3 class="text-base font-semibold">{ d.Catalog.Name(f.Food.ID) }</h3>
			<span class="rh-chip">{ Num(f.Servings) } servings</span>
		</div>
		@LeafTable(f.Leaves)
		for _, ch := range f.Children {
			if steps := d.Steps[ch.ID]; len(steps) > 0 {
				<div>
					<p class="rh-overline mb-1">{ ch.Name }</p>
					<ol class="mp-steps">
						for _, st := range steps {
							<li>{ st.Instruction }</li>
						}
					</ol>
				</div>
			}
		}
		if len(f.Steps) > 0 {
			<div>
				if len(f.Children) > 0 {
					<p class="rh-overline mb-1">{ f.Food.Name }</p>
				}
				<ol class="mp-steps">
					for _, st := range f.Steps {
						<li>{ st.Instruction }</li>
					}
				</ol>
			</div>
		}
	</section>
}

templ PrepPrintPage(d service.PrepDetail) {
	@Print(d.Session.Name) {
		<div class="mx-auto max-w-3xl space-y-5 p-6">
			<header class="flex items-start justify-between gap-3">
				<div>
					<p class="rh-eyebrow">Prep session · { LongDate(d.Session.SessionDate) }</p>
					<h1 class="rh-h1 mt-1">{ d.Session.Name }</h1>
				</div>
				<button class="rh-btn rh-btn-secondary mp-noprint" type="button" data-print>@Icon("printer", 16) Print</button>
			</header>
			<section class="space-y-2">
				<h2 class="text-lg font-semibold">Foods</h2>
				<ul class="list-disc pl-5">
					for _, f := range d.Foods {
						<li>{ d.Catalog.Name(f.Food.ID) } — { Num(f.Servings) } servings</li>
					}
				</ul>
			</section>
			<section class="space-y-2">
				<h2 class="text-lg font-semibold">All ingredients</h2>
				<ul class="mp-print-list">
					for _, l := range d.Aggregated {
						<li><span class="mp-print-box"></span><span class="flex-1">{ l.Name }{ If(l.Variant != "", ", "+l.Variant, "") }</span><strong>{ Qty(l.Amount, l.Unit) }</strong></li>
					}
				</ul>
			</section>
			for _, f := range d.Foods {
				@prepBreakdown(d, f)
			}
		</div>
	}
}
