package view

import (
	"time"

	"github.com/google/uuid"

	"github.com/icylionz/mealplanner/internal/repo/db"
	"github.com/icylionz/mealplanner/internal/service"
)

// mealFoods renders food chips as plain spans: they sit inside the card link.
templ mealFoods(m service.MealView) {
	<span class="flex flex-wrap gap-1.5">
		for _, f := range m.Foods {
			<span class={ "rh-chip " + If(f.Deleted, "rh-chip-danger", "rh-chip-cat") }>
				{ f.Name }
				<span class="opacity-70">× { Num(f.Servings) }</span>
				if f.Override != nil {
					<span class="opacity-70" title="Per-recipe servings override">*</span>
				}
			</span>
		}
	</span>
}

// MealCard state is "next", "done", or "" (later / unspecified).
templ MealCard(m service.MealView, state string) {
	<a class={ "mp-meal", templ.KV("is-next", state == "next"), templ.KV("is-done", state == "done") } href={ URL("/meals/" + m.Meal.ID.String()) }>
		<span class="mp-meal-time">
			<span class="font-display text-lg font-bold">{ Clock(m.Meal.PlanTime) }</span>
			switch state {
				case "next":
					<span class="rh-pill-upcoming">Up next</span>
				case "done":
					<span class="mp-meal-done">@Icon("check", 12)<span>Done</span></span>
			}
		</span>
		<span class="flex min-w-0 flex-1 flex-col gap-1.5">
			<span class="flex items-center gap-2">
				<span class="truncate text-[15px] font-semibold text-slate-900">{ m.Title() }</span>
				if m.Series != nil {
					<span class="text-slate-400" title="Recurring">@Icon("repeat", 14)</span>
				}
			</span>
			@mealFoods(m)
			if m.Meal.Notes != "" && state != "done" {
				<span class="line-clamp-2 text-sm text-slate-600">{ m.Meal.Notes }</span>
			}
		</span>
		<span class="text-slate-400">@Icon("chevron-right", 18)</span>
	</a>
}

type TodayData struct {
	Date      time.Time
	Meals     []service.MealView
	Next      int // index into Meals, -1 when every meal has passed
	NextIn    int // minutes until Meals[Next]
	WeekMeals int // meals over today plus the next six days
	Upcoming  []DayMeals
	Lists     []db.ListGroceryListsRow // open lists with unchecked items
	Prep      []db.ListPrepSessionsRow // sessions today or later, soonest first
}

type DayMeals struct {
	Date  time.Time
	Meals []service.MealView
}

func todayState(d TodayData, i int) string {
	switch {
	case i == d.Next:
		return "next"
	case d.Next < 0 || i < d.Next:
		return "done"
	}
	return ""
}

func todayDone(d TodayData) int {
	if d.Next < 0 {
		return len(d.Meals)
	}
	return d.Next
}

func todaySub(d TodayData) string {
	if len(d.Meals) == 0 {
		return "No meals planned today · " + Plural(d.WeekMeals, "meal", "meals") + " this week"
	}
	return Plural(len(d.Meals), "meal", "meals") + " today · " + Plural(d.WeekMeals, "meal", "meals") + " this week"
}

templ TodayPage(d TodayData) {
	@Shell(Meta{Title: "Today", Active: "today"}) {
		@PageHeader(LongDate(d.Date), "Today", todaySub(d)) {
			if IsOwner(ctx) {
				<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(d.Date))) }>@Icon("plus", 16) Add meal</a>
			}
			<a class="rh-btn rh-btn-secondary" href={ URL("/plan") }>Open plan</a>
		}
		if len(d.Meals) > 0 {
			if d.Next >= 0 {
				@nextMeal(d.Meals[d.Next], d.NextIn)
			} else {
				<section class="mp-next is-clear">
					<span class="mp-empty-icon">@Icon("check-circle", 22)</span>
					<div class="min-w-0">
						<p class="text-base font-semibold text-slate-900">That's everything for today</p>
						<p class="text-sm text-slate-600">
							if len(d.Upcoming) > 0 && len(d.Upcoming[0].Meals) > 0 {
								Tomorrow starts with { d.Upcoming[0].Meals[0].Title() } at { Clock(d.Upcoming[0].Meals[0].Meal.PlanTime) }.
							} else {
								Nothing planned for tomorrow yet.
							}
						</p>
					</div>
				</section>
			}
		}
		<div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-start">
			<div class="space-y-4">
				if len(d.Meals) == 0 {
					@Empty("utensils", "Nothing planned today", "Schedule a meal to see it here.") {
						if IsOwner(ctx) {
							<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(d.Date))) }>Add a meal</a>
						} else {
							<a class="rh-btn rh-btn-secondary" href={ URL("/plan") }>View the plan</a>
						}
					}
				} else {
					<section class="space-y-2">
						<div class="flex items-baseline justify-between gap-3">
							<h2 class="text-base font-semibold text-slate-900">Today's meals</h2>
							<span class="text-sm tabular-nums text-slate-500">{ Itoa(todayDone(d)) } of { Itoa(len(d.Meals)) } done</span>
						</div>
						for i, m := range d.Meals {
							@MealCard(m, todayState(d, i))
						}
					</section>
				}
				@comingUp(d)
			</div>
			<aside class="space-y-4">
				@todayGrocery(d)
				@todayPrep(d)
			</aside>
		</div>
	}
}

templ nextMeal(m service.MealView, in int) {
	<section class="mp-next">
		<div class="flex flex-wrap items-center gap-2">
			<span class="rh-pill-upcoming">Up next</span>
			<span class="rh-overline">{ Clock(m.Meal.PlanTime) } · { Until(in) }</span>
		</div>
		<div class="flex min-w-0 flex-col gap-2">
			<h2 class="font-display text-2xl font-bold tracking-tight text-slate-900">
				<a class="hover:underline" href={ URL("/meals/" + m.Meal.ID.String()) }>{ m.Title() }</a>
			</h2>
			if m.Meal.Title != "" || len(m.Foods) > 1 {
				@mealFoods(m)
			}
			<p class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-600">
				<span class="inline-flex items-center gap-1.5">@Icon("users", 14)<span>Serves { Num(m.Meal.Servings) }</span></span>
				if m.Series != nil {
					<span class="inline-flex items-center gap-1.5">@Icon("repeat", 14)<span>Recurring</span></span>
				}
			</p>
			if m.Meal.Notes != "" {
				<p class="line-clamp-3 text-sm text-slate-700">{ m.Meal.Notes }</p>
			}
		</div>
		<div class="flex flex-wrap gap-2">
			<a class="rh-btn rh-btn-primary rh-btn-sm" href={ URL("/meals/" + m.Meal.ID.String()) }><span>Open meal</span>@Icon("arrow-right", 14)</a>
			if IsOwner(ctx) {
				<a class="rh-btn rh-btn-secondary rh-btn-sm" href={ templ.SafeURL(Query("/grocery/generate", "mode", "meal", "meal", m.Meal.ID.String())) }>@Icon("shopping-cart", 14) Shop for this</a>
			}
			if m.Meal.LinkUrl != "" {
				<a class="rh-btn rh-btn-ghost rh-btn-sm" href={ templ.SafeURL(m.Meal.LinkUrl) } target="_blank" rel="noopener noreferrer nofollow">@Icon("external-link", 14) Link</a>
			}
		</div>
	</section>
}

templ comingUp(d TodayData) {
	<section class="rh-card space-y-3">
		<div class="flex items-center justify-between">
			<h2 class="text-base font-semibold text-slate-900">Coming up</h2>
			<a class="text-sm font-semibold text-primary hover:underline" href={ templ.SafeURL(Query("/plan", "view", "week")) }>Week view</a>
		</div>
		<div class="divide-y divide-slate-200">
			for _, day := range d.Upcoming {
				<div class="mp-upcoming">
					<a class="mp-upcoming-date" href={ templ.SafeURL(Query("/plan", "view", "day", "date", ISODate(day.Date))) }>
						<span class="rh-overline">{ Weekday(day.Date) }</span>
						<span class="font-display text-lg font-bold">{ DayNum(day.Date) }</span>
					</a>
					<div class="min-w-0 flex-1 space-y-1 text-sm">
						if len(day.Meals) == 0 {
							<span class="text-slate-400">Nothing planned</span>
						} else {
							for _, m := range day.Meals {
								<a class="mp-upcoming-meal" href={ URL("/meals/" + m.Meal.ID.String()) }>
									<span class="w-16 shrink-0 tabular-nums text-slate-500">{ Clock(m.Meal.PlanTime) }</span>
									<span class="truncate font-medium text-slate-900">{ m.Title() }</span>
								</a>
							}
						}
					</div>
					if IsOwner(ctx) {
						<a class="mp-icon-btn" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(day.Date))) } title={ "Add a meal on " + ShortDate(day.Date) } aria-label={ "Add a meal on " + ShortDate(day.Date) }>@Icon("plus", 16)</a>
					}
				</div>
			}
		</div>
	</section>
}

templ todayGrocery(d TodayData) {
	<section class="rh-card space-y-3">
		<div class="flex items-center justify-between">
			<h2 class="inline-flex items-center gap-2 text-base font-semibold text-slate-900">@Icon("shopping-cart", 16)<span>Shopping</span></h2>
			<a class="text-sm font-semibold text-primary hover:underline" href={ URL("/grocery") }>All lists</a>
		</div>
		if len(d.Lists) == 0 {
			<p class="text-sm text-slate-500">No open grocery lists.</p>
		} else {
			<ul class="space-y-3">
				for _, l := range d.Lists {
					<li>
						<a class="block space-y-1.5 rounded-lg hover:bg-slate-50" href={ URL("/grocery/" + l.ID.String()) }>
							<span class="flex items-baseline justify-between gap-3 text-sm">
								<span class="truncate font-medium text-slate-900">{ l.Name }</span>
								<span class="shrink-0 tabular-nums text-slate-500">{ Itoa(int(l.ItemCount - l.CheckedCount)) } left</span>
							</span>
							<span class="rh-progress block"><span class="rh-progress-fill" style={ progressStyle(int(l.CheckedCount), int(l.ItemCount)) }></span></span>
						</a>
					</li>
				}
			</ul>
		}
		if IsOwner(ctx) {
			<a class="rh-btn rh-btn-secondary rh-btn-sm w-full justify-center" href={ URL("/grocery/generate") }>Generate for the week</a>
		}
	</section>
}

templ todayPrep(d TodayData) {
	<section class="rh-card space-y-3">
		<div class="flex items-center justify-between">
			<h2 class="inline-flex items-center gap-2 text-base font-semibold text-slate-900">@Icon("chef-hat", 16)<span>Prep</span></h2>
			<a class="text-sm font-semibold text-primary hover:underline" href={ URL("/prep") }>All sessions</a>
		</div>
		if len(d.Prep) == 0 {
			<p class="text-sm text-slate-500">No prep sessions scheduled.</p>
		} else {
			<ul class="divide-y divide-slate-200">
				for _, p := range d.Prep {
					<li>
						<a class="flex items-center justify-between gap-3 py-2 text-sm hover:bg-slate-50" href={ URL("/prep/" + p.ID.String()) }>
							<span class="min-w-0">
								<span class="block truncate font-medium text-slate-900">{ p.Name }</span>
								<span class="block text-slate-500">
									if ISODate(p.SessionDate) == ISODate(d.Date) {
										Today
									} else {
										{ ShortDate(p.SessionDate) }
									}
									· { Plural(int(p.FoodCount), "food", "foods") }
								</span>
							</span>
							<span class="text-slate-400">@Icon("chevron-right", 16)</span>
						</a>
					</li>
				}
			</ul>
		}
	</section>
}

type PlanData struct {
	View  string // day | week
	Date  time.Time
	Days  []DayMeals
	Prev  time.Time
	Next  time.Time
	Today time.Time
}

templ PlanPage(d PlanData) {
	@Shell(Meta{Title: "Plan", Active: "plan"}) {
		@PageHeader(If(d.View == "week", "Week of "+ShortDate(d.Days[0].Date), LongDate(d.Date)), "Plan", "") {
			if IsOwner(ctx) {
				<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(d.Date))) }>@Icon("plus", 16) Add meal</a>
				<a class="rh-btn rh-btn-secondary" href={ templ.SafeURL(Query("/grocery/generate", "mode", "range", "from", ISODate(d.Days[0].Date), "to", ISODate(d.Days[len(d.Days)-1].Date))) }>@Icon("shopping-cart", 16) Shop this { If(d.View == "week", "week", "day") }</a>
			}
		}
		<section class="flex flex-wrap items-center justify-between gap-3">
			<div class="rh-seg">
				<a class={ If(d.View == "day", "on", "") } href={ templ.SafeURL(Query("/plan", "view", "day", "date", ISODate(d.Date))) }>Day</a>
				<a class={ If(d.View == "week", "on", "") } href={ templ.SafeURL(Query("/plan", "view", "week", "date", ISODate(d.Date))) }>Week</a>
			</div>
			<div class="flex items-center gap-1.5">
				<a class="rh-btn rh-btn-secondary rh-btn-sm" href={ templ.SafeURL(Query("/plan", "view", d.View, "date", ISODate(d.Prev))) } aria-label="Previous">@Icon("chevron-left", 16)</a>
				<a class="rh-btn rh-btn-secondary rh-btn-sm" href={ templ.SafeURL(Query("/plan", "view", d.View, "date", ISODate(d.Today))) }>Today</a>
				<a class="rh-btn rh-btn-secondary rh-btn-sm" href={ templ.SafeURL(Query("/plan", "view", d.View, "date", ISODate(d.Next))) } aria-label="Next">@Icon("chevron-right", 16)</a>
				<form method="get" action={ URL("/plan") } class="flex items-center gap-1.5">
					<input type="hidden" name="view" value={ d.View }/>
					<input class="rh-input h-7 py-0 text-xs" type="date" name="date" value={ ISODate(d.Date) } aria-label="Go to date" data-autosubmit/>
					<noscript><button class="rh-btn rh-btn-secondary rh-btn-sm" type="submit">Go</button></noscript>
				</form>
			</div>
		</section>
		if d.View == "week" {
			<section class="mp-week">
				for _, day := range d.Days {
					<div class={ "mp-week-day " + If(ISODate(day.Date) == ISODate(d.Today), "is-today", "") }>
						<a class="mp-week-head" href={ templ.SafeURL(Query("/plan", "view", "day", "date", ISODate(day.Date))) }>
							<span class="rh-overline">{ Weekday(day.Date) }</span>
							<span class="font-display text-xl font-bold">{ DayNum(day.Date) }</span>
						</a>
						<div class="space-y-1.5">
							for _, m := range day.Meals {
								<a class="mp-week-meal" href={ URL("/meals/" + m.Meal.ID.String()) }>
									<span class="text-[11px] font-semibold text-slate-500">{ Clock(m.Meal.PlanTime) }</span>
									<span class="block text-[13px] font-semibold leading-snug text-slate-900">{ m.Title() }</span>
								</a>
							}
							if IsOwner(ctx) {
								<a class="mp-week-add" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(day.Date))) }>@Icon("plus", 14) Add</a>
							}
						</div>
					</div>
				}
			</section>
		} else {
			if len(d.Days[0].Meals) == 0 {
				@Empty("calendar", "No meals on this day", "Pick another date or schedule something.") {
					if IsOwner(ctx) {
						<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/plan/new", "date", ISODate(d.Date))) }>Add a meal</a>
					}
				}
			} else {
				<section class="space-y-2">
					for _, m := range d.Days[0].Meals {
						@MealCard(m, "")
					}
				</section>
			}
		}
	}
}

type NewMealStep struct {
	Date   string
	Time   string
	Errors []string
}

// NewMealStepPage asks for date and time before recipe selection (FR5.1).
templ NewMealStepPage(d NewMealStep) {
	@Shell(Meta{Title: "Add meal", Active: "plan"}) {
		@PageHeader("Step 1 of 2", "When is this meal?", "Pick the date and time first, then choose what you'll eat.") {
		}
		@Errors(d.Errors)
		<form method="get" action={ URL("/plan/new/meal") } class="rh-card max-w-xl space-y-4">
			<div class="grid grid-cols-2 gap-3">
				<label class="rh-field">
					<span class="rh-label">Date</span>
					<input class="rh-input" type="date" name="date" value={ d.Date } required/>
				</label>
				<label class="rh-field">
					<span class="rh-label">Time</span>
					<input class="rh-input" type="time" name="time" value={ d.Time } required/>
				</label>
			</div>
			<div class="flex flex-wrap gap-2">
				for _, preset := range [][2]string{{"Breakfast", "08:00"}, {"Lunch", "12:30"}, {"Dinner", "18:30"}} {
					<a class="rh-chip hover:underline" href={ templ.SafeURL(Query("/plan/new/meal", "date", d.Date, "time", preset[1], "title", preset[0])) }>{ preset[0] } · { Clock(preset[1]) }</a>
				}
			</div>
			<div class="flex gap-2">
				<button class="rh-btn rh-btn-primary" type="submit">Choose foods @Icon("arrow-right", 16)</button>
				<a class="rh-btn rh-btn-ghost" href={ URL("/plan") }>Cancel</a>
			</div>
		</form>
	}
}

type FoodOption struct {
	ID    uuid.UUID
	Name  string
	Label string
}

type Conflict struct {
	Saved [][2]string
	Mine  [][2]string
}

templ ConflictPanel(c *Conflict) {
	if c != nil {
		<section class="rh-card space-y-3 border-amber-300">
			<div class="flex items-start gap-2 text-amber-700">
				@Icon("triangle-alert", 18)
				<div>
					<p class="font-semibold">Someone else saved this first</p>
					<p class="text-sm text-slate-600">Compare the saved version with your changes. Your changes are still in the form below; save again to apply them on top of the latest version.</p>
				</div>
			</div>
			<div class="grid gap-3 md:grid-cols-2">
				@conflictCol("Saved version", c.Saved)
				@conflictCol("Your attempted changes", c.Mine)
			</div>
		</section>
	}
}

templ conflictCol(title string, rows [][2]string) {
	<div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
		<p class="rh-overline mb-2">{ title }</p>
		<dl class="rh-schedule-facts">
			for _, r := range rows {
				<dt>{ r[0] }</dt>
				<dd>{ r[1] }</dd>
			}
		</dl>
	</div>
}

templ FoodDatalist(id string, opts []FoodOption) {
	<datalist id={ id }>
		for _, o := range opts {
			<option value={ o.Name }>{ o.Label }</option>
		}
	</datalist>
}

type MealEditor struct {
	Input    service.MealInput
	Names    map[uuid.UUID]string
	Options  []FoodOption
	Creating bool
	IsSeries bool
	Pick     string
	Errors   []string
	Conflict *Conflict
}

func (e MealEditor) Action() string {
	if e.Creating {
		return "/plan/new/meal"
	}
	return "/meals/" + e.Input.ID.String() + "/edit"
}

func weekdayOn(ws []int, d int) bool {
	for _, w := range ws {
		if w == d {
			return true
		}
	}
	return false
}

templ MealEditorPage(e MealEditor) {
	@Shell(Meta{Title: If(e.Creating, "Add meal", "Edit meal"), Active: "plan"}) {
		@PageHeader(If(e.Creating, "Step 2 of 2", "Edit"), If(e.Creating, "Choose foods", "Edit meal"), LongDate(e.Input.Date)+" · "+Clock(e.Input.Time)) {
		}
		@ConflictPanel(e.Conflict)
		@Errors(e.Errors)
		<form method="post" action={ URL(e.Action()) } class="space-y-4">
			@CSRFField()
			<button class="mp-default-submit" type="submit" name="op" value="refresh" tabindex="-1" aria-hidden="true">Refresh</button>
			<input type="hidden" name="version" value={ I32(e.Input.Version) }/>
			<input type="hidden" name="series_version" value={ I32(e.Input.SeriesVersion) }/>
			<section class="rh-card space-y-4">
				<h2 class="text-base font-semibold">Foods and recipes</h2>
				if len(e.Input.Foods) == 0 {
					<p class="text-sm text-slate-500">No foods yet. Search below and add one or more.</p>
				}
				<div class="space-y-2">
					for i, f := range e.Input.Foods {
						<div class="mp-line">
							<input type="hidden" name="food_id" value={ f.FoodID.String() }/>
							<div class="min-w-0 flex-1">
								<p class="truncate font-semibold">{ e.Names[f.FoodID] }</p>
								<p class="text-xs text-slate-500">{ If(i == 0, "Primary", "Additional") }</p>
							</div>
							<label class="flex items-center gap-1.5 text-xs text-slate-500">
								Servings
								<input class="rh-input w-20 py-1 text-sm" type="number" step="any" min="0" name="override" value={ OptNum(f.Override) } placeholder={ Num(e.Input.Servings) }/>
							</label>
							<button class="rh-btn rh-btn-ghost rh-btn-sm" type="submit" name="op" value={ "remove:" + Itoa(i) } aria-label="Remove">@Icon("x", 16)</button>
						</div>
					}
				</div>
				<div class="flex flex-wrap items-end gap-2">
					<label class="rh-field min-w-[220px] flex-1">
						<span class="rh-label">Add food or recipe</span>
						<input class="rh-input" type="search" name="pick" value={ e.Pick } list="meal-foods" placeholder="Search by name or alias" autocomplete="off"/>
					</label>
					<button class="rh-btn rh-btn-secondary" type="submit" name="op" value="add">@Icon("plus", 16) Add</button>
				</div>
				@FoodDatalist("meal-foods", e.Options)
			</section>
			<section class="rh-card space-y-4">
				<h2 class="text-base font-semibold">Details</h2>
				<div class="grid gap-3 sm:grid-cols-3">
					<label class="rh-field">
						<span class="rh-label">Date</span>
						<input class="rh-input" type="date" name="date" value={ ISODate(e.Input.Date) } required/>
					</label>
					<label class="rh-field">
						<span class="rh-label">Time</span>
						<input class="rh-input" type="time" name="time" value={ e.Input.Time } required/>
					</label>
					<label class="rh-field">
						<span class="rh-label">Servings</span>
						<input class="rh-input" type="number" step="any" min="0" name="servings" value={ Num(e.Input.Servings) } required/>
						<span class="rh-label-hint">Every recipe uses this unless overridden.</span>
					</label>
				</div>
				<label class="rh-field">
					<span class="rh-label">Title (optional)</span>
					<input class="rh-input" type="text" name="title" value={ e.Input.Title } placeholder="Defaults to the food names"/>
				</label>
				<label class="rh-field">
					<span class="rh-label">Notes</span>
					<textarea class="rh-textarea" name="notes" rows="3">{ e.Input.Notes }</textarea>
				</label>
				<label class="rh-field">
					<span class="rh-label">Link (optional)</span>
					<input class="rh-input" type="url" name="link" value={ e.Input.Link } placeholder="https://"/>
				</label>
			</section>
			if e.Creating {
				<section class="rh-card space-y-3">
					<h2 class="text-base font-semibold">Repeat</h2>
					<div class="rh-seg">
						for _, o := range [][2]string{{"", "Once"}, {"daily", "Daily"}, {"weekly", "Weekly"}} {
							<label class={ "mp-seg-radio " + If(e.Input.Freq == o[0], "on", "") }>
								<input type="radio" name="freq" value={ o[0] } checked?={ e.Input.Freq == o[0] }/>
								{ o[1] }
							</label>
						}
					</div>
					<div class="flex flex-wrap gap-1.5">
						for i, n := range WeekdayNames {
							<label class="mp-day-check">
								<input type="checkbox" name="weekday" value={ Itoa(i) } checked?={ weekdayOn(e.Input.Weekdays, i) }/>
								<span>{ n }</span>
							</label>
						}
					</div>
					<p class="rh-label-hint">Weekdays apply to weekly repeats; none selected means the start date's weekday.</p>
					<label class="rh-field max-w-xs">
						<span class="rh-label">Repeat until</span>
						<input class="rh-input" type="date" name="until" value={ optDate(e.Input.Until) }/>
					</label>
				</section>
			}
			if e.IsSeries {
				<section class="rh-card space-y-3">
					<h2 class="text-base font-semibold">Apply changes to</h2>
					<div class="grid gap-2 sm:grid-cols-3">
						for _, o := range [][3]string{{"this", "This occurrence", "Only this date changes."}, {"future", "This and future", "Earlier dates stay as they are."}, {"all", "All occurrences", "Every date in the series."}} {
							<label class={ "mp-option " + If(e.Input.Scope == o[0], "is-on", "") }>
								<input type="radio" name="scope" value={ o[0] } checked?={ e.Input.Scope == o[0] }/>
								<span>
									<span class="block font-semibold">{ o[1] }</span>
									<span class="block text-xs text-slate-500">{ o[2] }</span>
								</span>
							</label>
						}
					</div>
					<p class="rh-label-hint">Date changes only apply to "This occurrence".</p>
				</section>
			}
			<div class="flex flex-wrap gap-2">
				<button class="rh-btn rh-btn-primary" type="submit" name="op" value="save">@Icon("check", 16) Save meal</button>
				<a class="rh-btn rh-btn-ghost" href={ URL(If(e.Creating, "/plan", "/meals/"+e.Input.ID.String())) }>Cancel</a>
			</div>
		</form>
	}
}

func optDate(t *time.Time) string {
	if t == nil {
		return ""
	}
	return ISODate(*t)
}

type MealDetail struct {
	Meal     service.MealView
	Leaves   []service.Aggregated
	Estimate service.Estimate
}

templ MealDetailPage(d MealDetail) {
	@Shell(Meta{Title: d.Meal.Title(), Active: "plan"}) {
		<nav class="rh-crumb"><a href={ templ.SafeURL(Query("/plan", "date", ISODate(d.Meal.Meal.PlanDate))) }>Plan</a><span class="sep">/</span><span class="here">{ ShortDate(d.Meal.Meal.PlanDate) }</span></nav>
		@PageHeader(LongDate(d.Meal.Meal.PlanDate)+" · "+Clock(d.Meal.Meal.PlanTime), d.Meal.Title(), "") {
			if IsOwner(ctx) && d.Meal.Meal.DeletedAt == nil {
				<a class="rh-btn rh-btn-primary" href={ URL("/meals/" + d.Meal.Meal.ID.String() + "/edit") }>@Icon("pencil", 16) Edit</a>
				<a class="rh-btn rh-btn-secondary" href={ templ.SafeURL(Query("/grocery/generate", "mode", "meal", "meal", d.Meal.Meal.ID.String())) }>@Icon("shopping-cart", 16) Add to grocery list</a>
			}
		}
		if d.Meal.Meal.DeletedAt != nil {
			<div class="mp-flash is-warn">@Icon("archive", 16) This meal was deleted. It is kept for grocery history.</div>
		}
		<div class="grid gap-4 lg:grid-cols-[3fr_2fr]">
			<div class="space-y-4">
				<section class="rh-card space-y-3">
					<h2 class="text-base font-semibold">Foods</h2>
					<div class="divide-y divide-slate-200">
						for i, f := range d.Meal.Foods {
							<div class="flex items-center justify-between gap-3 py-2.5">
								<div class="min-w-0">
									<a class="font-semibold hover:underline" href={ URL("/foods/" + f.FoodID.String()) }>{ f.Name }</a>
									<p class="text-xs text-slate-500">{ If(i == 0, "Primary", "Additional") } · { If(f.Recipe, "Recipe", "Food") }</p>
								</div>
								<div class="text-right text-sm">
									<span class="font-semibold">{ Num(f.Servings) } servings</span>
									if f.Override != nil {
										<p class="text-xs text-amber-700">Override (meal: { Num(d.Meal.Meal.Servings) })</p>
									}
								</div>
							</div>
						}
					</div>
				</section>
				<section class="rh-card space-y-3">
					<div class="flex items-center justify-between">
						<h2 class="text-base font-semibold">Ingredients</h2>
						<span class="rh-chip">{ Plural(len(d.Leaves), "item", "items") }</span>
					</div>
					@LeafTable(d.Leaves)
				</section>
			</div>
			<div class="space-y-4">
				<section class="rh-card space-y-2">
					<p class="rh-overline">Details</p>
					<dl class="rh-schedule-facts">
						<dt>Servings</dt><dd>{ Num(d.Meal.Meal.Servings) }</dd>
						if d.Meal.Series != nil {
							<dt>Repeats</dt><dd>{ d.Meal.Series.Freq } until { ShortDate(d.Meal.Series.UntilDate) }</dd>
						}
						if d.Meal.Meal.LinkUrl != "" {
							<dt>Link</dt>
							<dd><a class="inline-flex items-center gap-1 font-semibold text-primary hover:underline" href={ templ.SafeURL(d.Meal.Meal.LinkUrl) } target="_blank" rel="noopener noreferrer nofollow">{ d.Meal.Meal.LinkUrl } @Icon("external-link", 12)</a></dd>
						}
					</dl>
					if d.Meal.Meal.Notes != "" {
						<p class="whitespace-pre-line pt-2 text-sm text-slate-700">{ d.Meal.Meal.Notes }</p>
					}
				</section>
				@EstimateCard(d.Estimate, "for this meal")
				if IsOwner(ctx) && d.Meal.Meal.DeletedAt == nil {
					<section class="rh-card space-y-3">
						<p class="rh-overline">Delete</p>
						<form method="post" action={ URL("/meals/" + d.Meal.Meal.ID.String() + "/delete") } class="space-y-3" data-confirm="Delete this meal?">
							@CSRFField()
							if d.Meal.Series != nil {
								<select class="rh-select w-full" name="scope">
									<option value="this">This occurrence</option>
									<option value="future">This and future occurrences</option>
									<option value="all">All occurrences</option>
								</select>
							}
							<button class="rh-btn rh-btn-danger rh-btn-secondary" type="submit">@Icon("trash", 16) Delete meal</button>
						</form>
					</section>
				}
			</div>
		</div>
	}
}

templ LeafTable(leaves []service.Aggregated) {
	if len(leaves) == 0 {
		<p class="text-sm text-slate-500">No ingredients.</p>
	} else {
		<ul class="divide-y divide-slate-200">
			for _, l := range leaves {
				<li class="flex items-start justify-between gap-3 py-2">
					<div class="min-w-0">
						<a class="font-medium hover:underline" href={ URL("/foods/" + l.FoodID.String()) }>{ l.Name }</a>
						if l.Variant != "" {
							<span class="text-sm text-slate-500">, { l.Variant }</span>
						}
						if l.Review != "" {
							<p class="mt-0.5"><span class="rh-chip rh-chip-warn">@Icon("triangle-alert", 11)<span>{ l.Review }</span></span></p>
						}
					</div>
					<span class="shrink-0 font-semibold tabular-nums">{ Qty(l.Amount, l.Unit) }</span>
				</li>
			}
		</ul>
	}
}

templ EstimateCard(e service.Estimate, label string) {
	<section class="rh-stat">
		<p class="rh-stat-label">Estimated cost { label }</p>
		if e.Priced == 0 {
			<p class="rh-stat-value text-slate-400">—</p>
			<p class="rh-stat-trend">No recorded costs yet. Record costs on grocery items.</p>
		} else {
			<p class="rh-stat-value rh-money">{ Money(e.Total) }</p>
			<p class="rh-stat-trend">
				if e.Complete() {
					<span class="rh-chip rh-chip-success">@Icon("check", 11)<span>{ Coverage(e) }</span></span>
				} else {
					<span class="rh-chip rh-chip-warn">Partial · { Coverage(e) }</span>
				}
			</p>
		}
	</section>
}
