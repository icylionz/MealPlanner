package view

import (
	"github.com/google/uuid"

	"github.com/icylionz/mealplanner/internal/repo/db"
	"github.com/icylionz/mealplanner/internal/service"
)

templ GroceryListsPage(lists []db.ListGroceryListsRow, errors []string) {
	@Shell(Meta{Title: "Grocery", Active: "grocery"}) {
		@PageHeader("Shopping", "Grocery lists", "Live lists anyone in the household can check off.") {
			if IsOwner(ctx) {
				<a class="rh-btn rh-btn-primary" href={ URL("/grocery/generate") }>@Icon("git-merge", 16) Add from plan</a>
			}
		}
		@Errors(errors)
		if len(lists) == 0 {
			@Empty("shopping-cart", "No grocery lists yet", "Generate one from your plan or start an empty list.") {
				if IsOwner(ctx) {
					<a class="rh-btn rh-btn-primary" href={ URL("/grocery/generate") }>Add from plan</a>
				}
			}
		} else {
			<section class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
				for _, l := range lists {
					<a class="rh-card rh-card-tight block space-y-3 hover:border-indigo-200" href={ URL("/grocery/" + l.ID.String()) }>
						<div class="flex items-start justify-between gap-2">
							<div class="min-w-0">
								<p class="truncate text-base font-semibold text-slate-900">{ l.Name }</p>
								<p class="text-xs text-slate-500">Created { ShortDate(l.CreatedAt) }</p>
							</div>
							@Icon("chevron-right", 18)
						</div>
						<div class="rh-progress"><span class="rh-progress-fill" style={ progressStyle(int(l.CheckedCount), int(l.ItemCount)) }></span></div>
						<p class="text-sm text-slate-600">{ Itoa(int(l.CheckedCount)) } of { Plural(int(l.ItemCount), "item", "items") } checked</p>
					</a>
				}
			</section>
		}
		if IsOwner(ctx) {
			<form method="post" action={ URL("/grocery") } class="rh-card rh-card-tight flex flex-wrap items-end gap-2">
				@CSRFField()
				<label class="rh-field min-w-[200px] flex-1">
					<span class="rh-label">New empty list</span>
					<input class="rh-input" type="text" name="name" placeholder="Weekend shop" required/>
				</label>
				<button class="rh-btn rh-btn-secondary" type="submit">@Icon("plus", 16) Create list</button>
			</form>
		}
	}
}

func progressStyle(done, total int) templ.SafeCSS {
	pct := 0
	if total > 0 {
		pct = done * 100 / total
	}
	return templ.SafeCSS("width:" + Itoa(pct) + "%")
}

type ListPage struct {
	D       service.ListDetail
	Options []FoodOption
	Errors  []string
}

templ GroceryListPage(p ListPage) {
	@Shell(Meta{Title: p.D.List.Name, Active: "grocery"}) {
		<nav class="rh-crumb"><a href={ URL("/grocery") }>Grocery</a><span class="sep">/</span><span class="here">{ p.D.List.Name }</span></nav>
		@PageHeader(Itoa(p.D.Checked())+" of "+Plural(len(p.D.Items), "item", "items")+" checked", p.D.List.Name, "") {
			if IsOwner(ctx) {
				<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/grocery/generate", "list", p.D.List.ID.String())) }>@Icon("git-merge", 16) Add from plan</a>
			}
		}
		<div class="rh-progress"><span class="rh-progress-fill" style={ progressStyle(p.D.Checked(), len(p.D.Items)) }></span></div>
		@Errors(p.Errors)
		if len(p.D.Items) == 0 {
			@Empty("shopping-cart", "This list is empty", "Add items from your plan or type them in.") {
				if IsOwner(ctx) {
					<a class="rh-btn rh-btn-primary" href={ templ.SafeURL(Query("/grocery/generate", "list", p.D.List.ID.String())) }>Add from plan</a>
				}
			}
		} else {
			<ul class="mp-checklist">
				for _, it := range p.D.Items {
					<li class={ If(it.Checked, "is-checked", "") }>
						<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/check") }>
							@CSRFField()
							<input type="hidden" name="checked" value={ If(it.Checked, "false", "true") }/>
							<button class="mp-check" type="submit" aria-label={ If(it.Checked, "Uncheck ", "Check ") + it.Name } aria-pressed={ If(it.Checked, "true", "false") }>
								if it.Checked {
									@Icon("check", 16)
								}
							</button>
						</form>
						<a class="min-w-0 flex-1" href={ URL("/grocery/items/" + it.ID.String()) }>
							<span class="mp-check-name">{ it.Name }</span>
							if it.VariantText != "" {
								<span class="text-sm text-slate-500">, { it.VariantText }</span>
							}
							<span class="block text-xs text-slate-500">
								if p.D.Sources[it.ID] > 0 {
									{ Plural(p.D.Sources[it.ID], "source", "sources") }
								} else {
									Added by hand
								}
								if it.Cost != nil {
									· <span class="rh-money">{ Money(*it.Cost) }</span>
								}
							</span>
							if it.Note != "" {
								<span class={ "mt-1 " + If(len(it.Note) > 12 && it.Note[:12] == "Needs review", "rh-chip rh-chip-warn", "block text-xs text-slate-600") }>{ it.Note }</span>
							}
						</a>
						<span class="shrink-0 font-semibold tabular-nums">{ Qty(it.Amount, it.Unit) }</span>
					</li>
				}
			</ul>
		}
		if IsOwner(ctx) {
			<form method="post" action={ URL("/grocery/" + p.D.List.ID.String() + "/items") } class="rh-card rh-card-tight space-y-3">
				@CSRFField()
				<p class="rh-overline">Add item</p>
				<div class="flex flex-wrap items-end gap-2">
					<label class="rh-field min-w-[160px] flex-1">
						<span class="rh-label">Item</span>
						<input class="rh-input" type="text" name="name" list="grocery-foods" required autocomplete="off"/>
					</label>
					<label class="rh-field w-24">
						<span class="rh-label">Amount</span>
						<input class="rh-input" type="text" inputmode="decimal" name="amount" value="1"/>
					</label>
					<label class="rh-field">
						<span class="rh-label">Unit</span>
						@unitSelect("unit", "each")
					</label>
					<label class="rh-field min-w-[120px] flex-1">
						<span class="rh-label">Note</span>
						<input class="rh-input" type="text" name="note"/>
					</label>
					<button class="rh-btn rh-btn-secondary" type="submit">@Icon("plus", 16) Add</button>
				</div>
				@FoodDatalist("grocery-foods", p.Options)
			</form>
		}
		<div class="grid gap-4 md:grid-cols-2">
			<section class="rh-stat">
				<p class="rh-stat-label">Recorded spend</p>
				<p class="rh-stat-value rh-money">{ Money(p.D.Total) }</p>
				<p class="rh-stat-trend">{ Itoa(p.D.Priced) } of { Plural(len(p.D.Items), "item", "items") } priced</p>
			</section>
			if IsOwner(ctx) {
				<section class="rh-card rh-card-tight space-y-3">
					<form method="post" action={ URL("/grocery/" + p.D.List.ID.String() + "/rename") } class="flex items-end gap-2">
						@CSRFField()
						<label class="rh-field flex-1">
							<span class="rh-label">List name</span>
							<input class="rh-input" type="text" name="name" value={ p.D.List.Name } required/>
						</label>
						<button class="rh-btn rh-btn-secondary" type="submit">Rename</button>
					</form>
					<form method="post" action={ URL("/grocery/" + p.D.List.ID.String() + "/delete") } data-confirm="Delete this list?">
						@CSRFField()
						<button class="rh-btn rh-btn-danger" type="submit">@Icon("trash", 16) Delete list</button>
					</form>
				</section>
			}
		</div>
	}
}

type ItemPage struct {
	D      service.ItemDetail
	Errors []string
}

templ GroceryItemPage(p ItemPage) {
	{{ it := p.D.Item }}
	@Shell(Meta{Title: it.Name, Active: "grocery"}) {
		<nav class="rh-crumb"><a href={ URL("/grocery") }>Grocery</a><span class="sep">/</span><a href={ URL("/grocery/" + p.D.List.ID.String()) }>{ p.D.List.Name }</a><span class="sep">/</span><span class="here">{ it.Name }</span></nav>
		@PageHeader(If(it.SourceType == "generated", "Generated item", "Added by hand"), it.Name, Qty(it.Amount, it.Unit)+If(it.VariantText != "", " · "+it.VariantText, "")) {
			<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/check") }>
				@CSRFField()
				<input type="hidden" name="checked" value={ If(it.Checked, "false", "true") }/>
				<input type="hidden" name="back" value="item"/>
				<button class={ "rh-btn " + If(it.Checked, "rh-btn-secondary", "rh-btn-primary") } type="submit">
					@Icon(If(it.Checked, "square", "check-square"), 16)
					{ If(it.Checked, "Uncheck", "Check off") }
				</button>
			</form>
		}
		@Errors(p.Errors)
		if it.Note != "" {
			<div class="mp-flash is-warn">@Icon("info", 16)<span>{ it.Note }</span></div>
		}
		<div class="grid gap-4 lg:grid-cols-[3fr_2fr]">
			<section class="rh-card space-y-3">
				<h2 class="text-base font-semibold">Why this is here</h2>
				if len(p.D.Sources) == 0 {
					<p class="text-sm text-slate-500">This item was added directly to the list.</p>
				} else {
					<div class="rh-table-wrap mobile-scroll-table">
						<table class="rh-table">
							<thead><tr><th>Meal</th><th>Recipe</th><th class="num">Quantity</th></tr></thead>
							<tbody>
								for _, s := range p.D.Sources {
									<tr>
										<td>
											if s.MealID != nil && s.MealDate != nil {
												<a class="font-medium hover:underline" href={ URL("/meals/" + s.MealID.String()) }>{ s.MealTitle }</a>
												<span class="block text-xs text-slate-500">{ ShortDate(*s.MealDate) }</span>
											} else if s.MealID != nil {
												<span class="text-slate-500">{ s.MealTitle }</span>
											} else {
												<span class="text-slate-400">Added from a food</span>
											}
										</td>
										<td>
											if s.RecipeID != nil {
												<a class="hover:underline" href={ URL("/foods/" + s.RecipeID.String()) }>{ s.RecipeName }</a>
											} else {
												{ s.RecipeName }
											}
											if s.Source.VariantText != "" {
												<span class="block text-xs text-slate-500">{ s.Source.VariantText }</span>
											}
										</td>
										<td class="num">{ Qty(s.Source.QuantityContributed, s.Source.UnitContributed) }</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
				if p.D.Food != nil {
					<p class="text-sm text-slate-600">Food: <a class="font-semibold text-primary hover:underline" href={ URL("/foods/" + p.D.Food.ID.String()) }>{ p.D.Food.Name }</a>{ If(p.D.Food.Deleted(), " (deleted)", "") }</p>
				}
			</section>
			<div class="space-y-4">
				<section class="rh-stat">
					<p class="rh-stat-label">Cost paid</p>
					if it.Cost != nil {
						<p class="rh-stat-value rh-money">{ Money(*it.Cost) }</p>
						if p.D.CostPerUnit != nil {
							<p class="rh-stat-trend">{ Money(*p.D.CostPerUnit) } per { If(it.Unit == "", "each", it.Unit) }</p>
						}
					} else {
						<p class="rh-stat-value text-slate-400">—</p>
					}
					if IsOwner(ctx) {
						<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/cost") } class="mt-2 flex items-end gap-2">
							@CSRFField()
							<label class="rh-field flex-1">
								<span class="rh-label">Total paid for { Qty(it.Amount, it.Unit) }</span>
								<input class="rh-input" type="number" step="0.01" min="0" name="cost" value={ OptNum(it.Cost) } placeholder="0.00"/>
							</label>
							<button class="rh-btn rh-btn-secondary" type="submit">Save cost</button>
						</form>
					}
				</section>
				if IsOwner(ctx) {
					<section class="rh-card space-y-3">
						<p class="rh-overline">Edit line</p>
						<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/edit") } class="space-y-3">
							@CSRFField()
							<label class="rh-field"><span class="rh-label">Name</span><input class="rh-input" type="text" name="name" value={ it.Name } required/></label>
							<div class="grid grid-cols-2 gap-2">
								<label class="rh-field"><span class="rh-label">Amount</span><input class="rh-input" type="number" step="any" min="0" name="amount" value={ Num(it.Amount) }/></label>
								<label class="rh-field"><span class="rh-label">Unit</span><input class="rh-input" type="text" name="unit" value={ it.Unit }/></label>
							</div>
							<label class="rh-field"><span class="rh-label">Variant</span><input class="rh-input" type="text" name="variant" value={ it.VariantText }/></label>
							<label class="rh-field"><span class="rh-label">Note</span><input class="rh-input" type="text" name="note" value={ it.Note }/></label>
							<button class="rh-btn rh-btn-secondary" type="submit">Save line</button>
						</form>
						<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/convert") } class="flex items-end gap-2 border-t border-slate-200 pt-3">
							@CSRFField()
							<label class="rh-field flex-1">
								<span class="rh-label">Convert to</span>
								@unitSelect("unit", it.Unit)
							</label>
							<button class="rh-btn rh-btn-secondary" type="submit">@Icon("scale", 16) Convert</button>
						</form>
						<p class="rh-label-hint">Edits change only this list, not the foods or meals it came from.</p>
						<form method="post" action={ URL("/grocery/items/" + it.ID.String() + "/delete") } class="border-t border-slate-200 pt-3" data-confirm="Remove this item from the list?">
							@CSRFField()
							<button class="rh-btn rh-btn-danger" type="submit">@Icon("trash", 16) Remove from list</button>
						</form>
					</section>
				}
			</div>
		</div>
	}
}

type MealOption struct {
	ID    uuid.UUID
	Label string
}

type GenerateForm struct {
	Req      service.GenerateRequest
	FoodName string
	Lists    []db.ListGroceryListsRow
	Meals    []MealOption
	Options  []FoodOption
	Errors   []string
}

templ GeneratePage(f GenerateForm) {
	@Shell(Meta{Title: "Add from plan", Active: "grocery"}) {
		@PageHeader("Grocery", "Add ingredients to a list", "Ingredients are scaled, merged by food and variant, and stay traceable to their source.") {
		}
		@Errors(f.Errors)
		<form method="post" action={ URL("/grocery/generate") } class="space-y-4">
			@CSRFField()
			<section class="rh-card space-y-4">
				<h2 class="text-base font-semibold">1. Choose the source</h2>
				<div class="grid gap-3 md:grid-cols-3">
					<label class={ "mp-option flex-col items-stretch " + If(f.Req.Mode == "range", "is-on", "") }>
						<span class="flex items-center gap-2"><input type="radio" name="mode" value="range" checked?={ f.Req.Mode == "range" }/><span class="font-semibold">Date range</span></span>
						<span class="grid grid-cols-2 gap-2">
							<input class="rh-input py-1.5 text-sm" type="date" name="from" value={ ISODate(f.Req.From) } aria-label="From"/>
							<input class="rh-input py-1.5 text-sm" type="date" name="to" value={ ISODate(f.Req.To) } aria-label="To"/>
						</span>
						<span class="text-xs text-slate-500">Every meal planned in the range.</span>
					</label>
					<label class={ "mp-option flex-col items-stretch " + If(f.Req.Mode == "meal", "is-on", "") }>
						<span class="flex items-center gap-2"><input type="radio" name="mode" value="meal" checked?={ f.Req.Mode == "meal" }/><span class="font-semibold">One planned meal</span></span>
						<select class="rh-select py-1.5 text-sm" name="meal" aria-label="Meal">
							<option value="">Choose a meal…</option>
							for _, m := range f.Meals {
								<option value={ m.ID.String() } selected?={ m.ID == f.Req.MealID }>{ m.Label }</option>
							}
						</select>
						<span class="text-xs text-slate-500">Uses the meal's servings and overrides.</span>
					</label>
					<label class={ "mp-option flex-col items-stretch " + If(f.Req.Mode == "food", "is-on", "") }>
						<span class="flex items-center gap-2"><input type="radio" name="mode" value="food" checked?={ f.Req.Mode == "food" }/><span class="font-semibold">A food or recipe</span></span>
						<input class="rh-input py-1.5 text-sm" type="search" name="food_name" value={ f.FoodName } list="gen-foods" placeholder="Search foods" autocomplete="off" aria-label="Food"/>
						<input class="rh-input py-1.5 text-sm" type="number" step="any" min="0" name="servings" value={ Num(f.Req.Servings) } aria-label="Servings"/>
						<span class="text-xs text-slate-500">Leaf ingredients for these servings.</span>
					</label>
				</div>
				@FoodDatalist("gen-foods", f.Options)
			</section>
			<section class="rh-card space-y-4">
				<h2 class="text-base font-semibold">2. Choose the list</h2>
				<div class="grid gap-3 sm:grid-cols-2">
					<label class="rh-field">
						<span class="rh-label">Add to</span>
						<select class="rh-select" name="list">
							<option value="" selected?={ f.Req.ListID == uuid.Nil }>A new list</option>
							for _, l := range f.Lists {
								<option value={ l.ID.String() } selected?={ l.ID == f.Req.ListID }>{ l.Name } ({ Plural(int(l.ItemCount), "item", "items") })</option>
							}
						</select>
					</label>
					<label class="rh-field">
						<span class="rh-label">New list name</span>
						<input class="rh-input" type="text" name="new_name" value={ f.Req.NewName } placeholder={ service.GeneratedListName }/>
					</label>
				</div>
				<p class="rh-label-hint">When adding to an existing list, matching unchecked items are merged and their sources kept.</p>
			</section>
			<div class="flex gap-2">
				<button class="rh-btn rh-btn-primary" type="submit">@Icon("shopping-cart", 16) Add ingredients</button>
				<a class="rh-btn rh-btn-ghost" href={ URL("/grocery") }>Cancel</a>
			</div>
		</form>
	}
}
