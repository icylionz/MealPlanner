package pages

import (
	"strings"

	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

func reconcileTitle(d ImportReconcileData) string {
	if d.TargetFoodID != "" {
		return "Review re-import"
	}
	return "Reconcile import"
}

func reconcileBack(d ImportReconcileData) string {
	if d.TargetFoodID != "" {
		return "/foods/" + d.TargetFoodID
	}
	return "/import"
}

func reconcileAction(d ImportReconcileData) string {
	if d.Conflict != nil {
		return "reapply"
	}
	return "commit"
}

// ImportReconcile renders the import reconcile screen: the parsed recipe with a
// food dropdown per ingredient line. Each line must map to an existing food (or
// be created as a new one) before the recipe can be saved. The whole form posts
// back with an `action`, so it works without JavaScript.
templ ImportReconcile(d ImportReconcileData) {
	@layout.ModalPageWide(reconcileTitle(d), reconcileTitle(d)+" — Backbone Plate", "foods", d.Member, reconcileBack(d)) {
		<form method="post" action={ templ.URL(view.Href(ctx, "/import/reconcile")) }>
			<input type="hidden" name="target_food_id" value={ d.TargetFoodID }/>
			<input type="hidden" name="version" value={ d.Version }/>
			<input type="hidden" name="reapply_version" value={ d.ReapplyVersion }/>
			<input type="hidden" name="source_state" value={ d.SourceState }/>
			<input type="hidden" name="imp_default_unit" value={ d.DefaultUnit }/>
			<div class="modal-body">
				<div class="flex flex-col" style="gap: 14px;">
					if d.Error != "" {
						<div class="flex items-center" style="gap: 6px; color: var(--danger); background: var(--danger-tint); border-radius: var(--radius-sm); padding: 10px 12px; font-size: 13px;">
							@icons.Icon("alert-circle", 14)
							{ d.Error }
						</div>
					}
					if d.Conflict != nil {
						<div class="card" style="padding: 12px; border-color: var(--danger);">
							<div class="overline" style="color: var(--danger); margin-bottom: 8px;">Current saved version</div>
							<div style="font-size: 13px; color: var(--fg-2);"><strong>{ d.Conflict.Name }</strong> (version { view.Itoa(d.Conflict.Version) })</div>
							if d.Conflict.Description != "" {
								<div style="font-size: 12px; color: var(--fg-3); margin-top: 4px;">{ d.Conflict.Description }</div>
							}
							if d.Conflict.SourceURL != "" {
								<div style="font-size: 11px; color: var(--fg-4); margin-top: 4px; overflow-wrap: anywhere;">Current source: { d.Conflict.SourceURL }</div>
							}
							<div class="overline" style="margin: 12px 0 6px;">Fetched attempt</div>
							<div style="font-size: 13px; color: var(--fg-2);"><strong>{ d.Name }</strong> (started from version { d.Version })</div>
							if d.Description != "" {
								<div style="font-size: 12px; color: var(--fg-3); margin-top: 4px;">{ d.Description }</div>
							}
							if d.SourceURL != "" {
								<div style="font-size: 11px; color: var(--fg-4); margin-top: 4px; overflow-wrap: anywhere;">Fetched source: { d.SourceURL }</div>
							}
							<div style="font-size: 12px; color: var(--fg-3); margin-top: 8px;">Reapply these fetched values explicitly to replace the current version.</div>
						</div>
					}
					<div>
						<div class="overline" style="margin-bottom: 4px;">
							if d.TargetFoodID != "" {
								Re-importing
							} else {
								Importing
							}
						</div>
						if d.SourceURL != "" {
							<div style="font-size: 11px; color: var(--fg-4); margin-top: 4px; overflow-wrap: anywhere;">Source: { d.SourceURL }</div>
						}
					</div>
					<div>
						@FieldLabel("Name")
						<input class="input" name="imp_name" value={ d.Name } required/>
					</div>
					<div>
						@FieldLabel("Description")
						<textarea class="textarea" name="imp_desc" placeholder="Optional short description">{ d.Description }</textarea>
					</div>
					<div class="flex" style="gap: 10px;">
						<div class="flex-1">
							@FieldLabel("Prep time (min)")
							<input class="input input-sm" type="number" min="0" name="imp_prep" value={ d.Prep } required/>
						</div>
						<div class="flex-1">
							@FieldLabel("Cook time (min)")
							<input class="input input-sm" type="number" min="0" name="imp_cook" value={ d.Cook } required/>
						</div>
						<div class="flex-1">
							@FieldLabel("Servings / yield")
							<input class="input input-sm" type="number" min="1" name="imp_servings" value={ d.Servings } required/>
						</div>
					</div>
					<div class="flex" style="gap: 10px;">
						<div class="flex-1">
							@FieldLabel("Tags")
							<div class="flex flex-col" style="gap: 6px;">
								for _, tag := range d.Tags {
									<input class="input input-sm" name="imp_tags" value={ tag } placeholder="Tag"/>
								}
								<input class="input input-sm" name="imp_tags" placeholder="Add tag"/>
							</div>
						</div>
						<div class="flex-1">
							@FieldLabel("Aliases")
							<div class="flex flex-col" style="gap: 6px;">
								for _, alias := range d.Aliases {
									<input class="input input-sm" name="imp_aliases" value={ alias } placeholder="Alias"/>
								}
								<input class="input input-sm" name="imp_aliases" placeholder="Add alias"/>
							</div>
						</div>
					</div>
					<div>
						@FieldLabel("Steps")
						<div class="flex flex-col" style="gap: 6px;">
							for i, step := range d.Steps {
								<textarea class="textarea" name="imp_steps" placeholder={ "Step " + view.Itoa(i+1) } style="min-height: 56px; font-size: 13px;">{ step }</textarea>
							}
							<textarea class="textarea" name="imp_steps" placeholder="Add step" style="min-height: 56px; font-size: 13px;"></textarea>
						</div>
					</div>
					<div>
						<div class="overline" style="margin-bottom: 6px;">Match each ingredient to a food</div>
						<div class="flex flex-col" style="gap: 6px;">
							for i, line := range d.Lines {
								@importLineRow(d, i, line)
							}
						</div>
					</div>
				</div>
			</div>
			<div class="modal-foot">
				<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, reconcileBack(d))) }>Back</a>
				<button type="submit" name="action" value={ reconcileAction(d) } class="btn btn-sm">
					@icons.Icon("check", 14)
					if d.Conflict != nil {
						Reapply fetched changes
					} else if d.TargetFoodID != "" {
						Apply changes
					} else {
						Save recipe
					}
				</button>
			</div>
		</form>
	}
}

templ importLineRow(d ImportReconcileData, i int, line ImportLine) {
	<div class="recon-row">
		<input type="hidden" name="line_name" value={ line.Name }/>
		<div class="recon-name">
			<div class="recon-name-text">{ line.Name }</div>
			if !line.Matched() {
				<div class="overline" style="font-size: 9px; color: var(--danger); letter-spacing: .05em;">unmatched</div>
			}
			<input class="input input-sm" name="line_variant" value={ line.Variant } placeholder="Variant / form" style="margin-top: 4px;"/>
		</div>
		<input class="input input-sm recon-amount" type="number" step="any" min="0" name="line_amount" value={ line.Amount }/>
		<input class="input input-sm recon-unit" name="line_unit" value={ line.Unit }/>
		<select
			class="select input-sm recon-food"
			name="line_food"
			data-search-select="1"
			data-search-select-placeholder="Search foods…"
		>
			<option value="" selected?={ line.FoodID == "" }>— unmatched —</option>
			for _, f := range d.AllFoods {
				<option value={ f.ID.String() } data-search-terms={ strings.Join(f.Aliases, " ") } selected?={ line.FoodID == f.ID.String() }>{ f.Name }</option>
			}
		</select>
		<button type="submit" name="action" value={ "create-line:" + view.Itoa(i) } class="btn btn-secondary btn-xs" title="Create this as a new food">
			@icons.Icon("plus", 12)
			New
		</button>
	</div>
}
