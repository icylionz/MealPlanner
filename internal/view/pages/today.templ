package pages

import (
	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

// Today renders the Today screen.
templ Today(d TodayData) {
	@layout.Shell("Today — Backbone Plate", "today", d.Member) {
		@layout.PageHeader("Today", d.DateLabel) {
			if d.Member.IsOwner() {
				<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/meals/new?date="+d.Date+"&return=/today")) }>
					@icons.Icon("plus", 14)
					Add meal
				</a>
			}
		}
		<div class="page-pad flex-1 flex flex-col" style="gap: 10px;">
			if len(d.Meals) == 0 {
				@layout.Empty("sun", "Nothing planned today", "Add a meal to see it here.") {
					if d.Member.IsOwner() {
						<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/meals/new?date="+d.Date+"&return=/today")) }>
							@icons.Icon("plus", 14)
							Add a meal
						</a>
					}
				}
			}
			for _, m := range d.Meals {
				@todayMealRow(m, d.Member.IsOwner())
			}
		</div>
	}
}

templ todayMealRow(m MealVM, owner bool) {
	<div class={ "card card-flush meal-row", templ.KV("past", m.IsPast), templ.KV("next", m.IsNext) }>
		<div class="meal-time">{ m.Meal.Time }</div>
		<a class="meal-link" href={ templ.URL(view.Href(ctx, "/foods/"+m.Meal.FoodID.String())) }>
			<div class="flex-1 min-w-0">
				<div class="flex items-center" style="gap: 5px;">
					if m.Meal.Title != "" {
						<div class="overline" style="font-size: 10px; color: var(--fg-4); letter-spacing: .05em;">{ m.Meal.Title }</div>
					}
					<div class="meal-name">{ m.Food.Name }</div>
					if len(m.Extras) > 0 {
						<div style="font-size: 12px; color: var(--fg-3); margin-top: 2px;">
							+
							for i, ex := range m.Extras {
								if i > 0 {
									{ ", " }
								}
								{ ex.Food.Name }
							}
						</div>
					}
					if m.Meal.IsRecurring() {
						<span title="Recurring" style="color: var(--fg-4); flex: none;">
							@icons.Icon("refresh", 12)
						</span>
					}
				</div>
				<div style="margin-top: 5px;">
					@RecipeTags(m.Food.Tags, 3)
				</div>
				if m.Meal.HasLink() {
					<div class="flex items-center min-w-0" style="gap: 4px; margin-top: 5px; color: var(--fg-3); font-size: 12px;">
						if view.IsExternalURL(m.Meal.LinkImageURL) {
							<img src={ m.Meal.LinkImageURL } alt="" style="width: 16px; height: 16px; border-radius: 3px; object-fit: cover; flex: none;"/>
						} else {
							@icons.Icon("link", 11)
						}
						<span class="truncate">
							if m.Meal.LinkTitle != "" {
								{ m.Meal.LinkTitle }
							} else {
								{ m.Meal.LinkURL }
							}
						</span>
					</div>
				}
			</div>
			<div class="text-right flex-none">
				<div class="tnum" style="font-size: 13px; color: var(--fg-3);">
					{ view.Itoa(m.Meal.Servings) } { view.Plural(m.Meal.Servings, "serving", "servings") }
				</div>
				if m.Food.PrepTime+m.Food.CookTime > 0 {
					<div class="overline" style="font-size: 10px; color: var(--fg-4); letter-spacing: .04em; margin-top: 2px;">
						{ view.Itoa(m.Food.PrepTime + m.Food.CookTime) } min
					</div>
				}
			</div>
			<span class="flex-none" style="color: var(--fg-4);">
				@icons.Icon("chevron-right", 15)
			</span>
		</a>
		if m.IsNext {
			<div class="next-badge">Next</div>
		}
		if owner {
			<a class="row-del" href={ templ.URL(view.Href(ctx, "/meals/"+m.Meal.ID.String()+"/edit?return=/today")) } title="Edit meal">
				@icons.Icon("pencil", 14)
			</a>
			<form method="post" action={ templ.URL(view.Href(ctx, "/meals/"+m.Meal.ID.String()+"/delete?return=/today")) } style="display: contents;">
				<button type="submit" class="row-del" title="Remove from plan">
					@icons.Icon("trash-2", 14)
				</button>
			</form>
		}
	</div>
}
