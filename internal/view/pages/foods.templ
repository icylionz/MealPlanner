package pages

import (
	"net/url"
	"slices"

	"mealplanner/internal/foods"

	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

// foodsQuery rebuilds the /foods query from the active filter state. Every
// link on the page (tag chip removal, kind chips, pager) derives from it so
// following one keeps every other filter, without JavaScript.
func foodsQuery(d FoodsData) url.Values {
	q := url.Values{}
	if d.Search != "" {
		q.Set("q", d.Search)
	}
	if d.PrepMin != "" {
		q.Set("prep_min", d.PrepMin)
	}
	if d.PrepMax != "" {
		q.Set("prep_max", d.PrepMax)
	}
	if d.CookMin != "" {
		q.Set("cook_min", d.CookMin)
	}
	if d.CookMax != "" {
		q.Set("cook_max", d.CookMax)
	}
	if d.TagMode == "or" {
		q.Set("tag_mode", "or")
	}
	if d.Kind != "" {
		q.Set("kind", d.Kind)
	}
	for _, t := range d.Tags {
		q.Add("tags", t)
	}
	return q
}

func foodsHref(q url.Values) string {
	if enc := q.Encode(); enc != "" {
		return "/foods?" + enc
	}
	return "/foods"
}

// foodsFilterHref is the current filter URL with one tag dropped, backing the
// removable tag chips.
func foodsFilterHref(d FoodsData, dropTag string) string {
	q := foodsQuery(d)
	q.Del("tags")
	for _, t := range d.Tags {
		if t != dropTag {
			q.Add("tags", t)
		}
	}
	return foodsHref(q)
}

// foodsKindHref switches the kind filter, returning to page one.
func foodsKindHref(d FoodsData, kind string) string {
	q := foodsQuery(d)
	q.Del("kind")
	if kind != "" {
		q.Set("kind", kind)
	}
	return foodsHref(q)
}

// foodsPageHref is the current filter URL at the given page.
func foodsPageHref(d FoodsData, page int) string {
	q := foodsQuery(d)
	if page > 1 {
		q.Set("page", view.Itoa(page))
	}
	return foodsHref(q)
}

// foodsHasFilter reports whether any filter is active, to show a Clear control.
func foodsHasFilter(d FoodsData) bool {
	return d.Search != "" || d.PrepMin != "" || d.PrepMax != "" ||
		d.CookMin != "" || d.CookMax != "" || len(d.Tags) > 0
}

// Foods renders the recipe library screen.
templ Foods(d FoodsData) {
	@layout.Shell("Recipes — Backbone Plate", "foods", d.Member) {
		@layout.PageHeader("Foods & Recipes", "Recipes") {
			if d.Member.IsOwner() {
				<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, "/import")) }>
					@icons.Icon("upload", 14)
					Import
				</a>
				<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/foods/new")) }>
					@icons.Icon("plus", 14)
					New food
				</a>
			}
		}
		// With JS, any non-search control change re-runs the filter immediately
		// (full page, swapped by htmx); Apply remains the no-JS path.
		<form
			method="get"
			action={ templ.URL(view.Href(ctx, "/foods")) }
			class="page-pad flex flex-col"
			style="padding: 14px 28px; border-bottom: 1px solid var(--line); background: var(--paper); gap: 12px;"
			hx-get={ view.Href(ctx, "/foods") }
			hx-trigger="submit, change[target.type!='search']"
			hx-target="body"
			hx-swap="innerHTML"
			hx-push-url="true"
		>
			if d.Kind != "" {
				<input type="hidden" name="kind" value={ d.Kind }/>
			}
			// Preserve the current tag selection so each Apply adds the newly
			// picked tag rather than replacing the set (works without JS).
			for _, t := range d.Tags {
				<input type="hidden" name="tags" value={ t }/>
			}
			<div class="flex items-end flex-wrap" style="gap: 12px;">
				<div class="flex-1" style="min-width: 220px; max-width: 340px;">
					@FieldLabel("Search")
					<div class="search-wrap">
						@icons.Icon("search", 14)
						// Typing swaps only the results region so the input keeps focus.
						<input
							class="input input-sm"
							type="search"
							name="q"
							value={ d.Search }
							placeholder="Name, ingredient, description…"
							autocomplete="off"
							hx-get={ view.Href(ctx, "/foods") }
							hx-trigger="input changed delay:250ms, search"
							hx-include="closest form"
							hx-target="#foods-results"
							hx-select="#foods-results"
							hx-swap="outerHTML"
							hx-push-url="true"
						/>
					</div>
				</div>
				<div>
					@FieldLabel("Prep (min)")
					<div class="flex items-center" style="gap: 6px;">
						<input class="input input-sm" type="number" min="0" name="prep_min" value={ d.PrepMin } placeholder="min" style="width: 74px;"/>
						<span style="color: var(--fg-3);">–</span>
						<input class="input input-sm" type="number" min="0" name="prep_max" value={ d.PrepMax } placeholder="max" style="width: 74px;"/>
					</div>
				</div>
				<div>
					@FieldLabel("Cook (min)")
					<div class="flex items-center" style="gap: 6px;">
						<input class="input input-sm" type="number" min="0" name="cook_min" value={ d.CookMin } placeholder="min" style="width: 74px;"/>
						<span style="color: var(--fg-3);">–</span>
						<input class="input input-sm" type="number" min="0" name="cook_max" value={ d.CookMax } placeholder="max" style="width: 74px;"/>
					</div>
				</div>
			</div>
			<div class="flex items-end flex-wrap" style="gap: 12px;">
				<div style="min-width: 200px;">
					@FieldLabel("Add tag")
					<select
						class="select input-sm"
						name="tags"
						data-search-select="1"
						data-search-select-placeholder="Search tags…"
					>
						<option value="" selected></option>
						for _, t := range d.AllTags {
							if !slices.Contains(d.Tags, t) {
								<option value={ t }>{ t }</option>
							}
						}
					</select>
				</div>
				<div>
					@FieldLabel("Match")
					<select class="select input-sm" name="tag_mode">
						<option value="and" selected?={ d.TagMode != "or" }>All tags</option>
						<option value="or" selected?={ d.TagMode == "or" }>Any tag</option>
					</select>
				</div>
				<button type="submit" class="btn btn-sm">Apply</button>
				if foodsHasFilter(d) {
					<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, "/foods")) }>Clear</a>
				}
			</div>
			if len(d.Tags) > 0 {
				<div class="flex flex-wrap items-center" style="gap: 6px;">
					for _, t := range d.Tags {
						<span class="tag tag-accent" style="gap: 5px; padding: 4px 8px;">
							{ t }
							<a class="icon-btn" style="color: var(--accent); padding: 0;" title="Remove tag" href={ templ.URL(view.Href(ctx, foodsFilterHref(d, t))) }>
								@icons.Icon("x", 10)
							</a>
						</span>
					}
				</div>
			}
		</form>
		<div id="foods-results" class="flex flex-col flex-1">
			<div class="ltoolbar">
				@kindChip(d, "", "All", d.RecipeCount+d.IngredientCount)
				@kindChip(d, "recipes", "Recipes", d.RecipeCount)
				@kindChip(d, "ingredients", "Ingredients", d.IngredientCount)
				<span class="lmeta" style="margin-left: auto;">{ view.Itoa(d.Matched) } of { view.Itoa(d.Total) }</span>
			</div>
			<div class="flex-1" style="background: var(--paper);">
				if len(d.Foods) == 0 {
					@layout.Empty("utensils", "No foods found", emptyFoodsBody(d.Search)) {
						if d.Member.IsOwner() {
							<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/foods/new")) }>
								@icons.Icon("plus", 14)
								New food
							</a>
						}
					}
				} else {
					<div class="page-pad" style="padding: 0 0 0 28px;">
						for _, r := range d.Foods {
							@foodRow(r, d.Member.IsOwner())
						}
					</div>
				}
			</div>
			if d.PageCount > 1 {
				@foodsPager(d)
			}
		</div>
	}
}

func emptyFoodsBody(search string) string {
	if search != "" {
		return "No results for \"" + search + "\"."
	}
	return "Add your first recipe to get started."
}

templ kindChip(d FoodsData, kind string, label string, count int) {
	<a class={ "chip", templ.KV("active", d.Kind == kind) } href={ templ.URL(view.Href(ctx, foodsKindHref(d, kind))) }>
		{ label }
		<span class="chip-count">{ view.Itoa(count) }</span>
	</a>
}

// foodRow is the prototype's RecipeRow ledger row. Recipes carry the
// ×servings gutter and ingredient/sub/time columns; atomic ingredients use
// the compact density with their default unit in the gutter.
templ foodRow(r foods.Food, owner bool) {
	<div class={ "lrow", templ.KV("lrow-compact", !r.IsRecipe()) }>
		<div class="lrow-gutter">
			if r.IsRecipe() {
				<div class="lrow-gutter-main">×{ view.Itoa(r.Servings) }</div>
				<div class="lrow-gutter-sub">serves</div>
			} else {
				<div class="lrow-gutter-main">{ foodUnit(r) }</div>
				<div class="lrow-gutter-sub">unit</div>
			}
		</div>
		<a class="lrow-main" href={ templ.URL(view.Href(ctx, "/foods/"+r.ID.String())) }>
			<div class="flex-1 min-w-0">
				<div class="lrow-title">{ r.Name }</div>
				if r.Description != "" {
					<div class="lrow-sub">{ r.Description }</div>
				}
				if len(r.Tags) > 0 {
					<div style="margin-top: 6px;">
						@RecipeTags(r.Tags, 4)
					</div>
				}
			</div>
			if r.IsRecipe() {
				<div class="lrow-col">{ view.Itoa(len(r.Components)) } ing</div>
				if SubCount(r) > 0 {
					<div class="lrow-col hide-sm" style="color: var(--accent);">{ view.Itoa(SubCount(r)) } sub</div>
				}
				if r.PrepTime+r.CookTime > 0 {
					<div class="lrow-col hide-sm">{ view.Itoa(r.PrepTime + r.CookTime) } min</div>
				}
			} else if r.HasDensity() {
				<div class="lrow-col hide-sm">{ FormatDensity(r.Density) } g/ml</div>
			}
			@icons.Icon("chevron-right", 14)
		</a>
		if owner {
			<a class="lrow-action" aria-label="Edit food" title="Edit food" href={ templ.URL(view.Href(ctx, "/foods/"+r.ID.String()+"/edit")) }>
				@icons.Icon("pencil", 14)
			</a>
		}
	</div>
}

func foodUnit(r foods.Food) string {
	if r.DefaultUnit != "" {
		return r.DefaultUnit
	}
	return "—"
}

templ foodsPager(d FoodsData) {
	<nav class="ltoolbar" aria-label="Pagination" style="border-top: 1px solid var(--line); border-bottom: none;">
		<span class="lmeta">
			{ view.Itoa(d.Offset + 1) }–{ view.Itoa(d.Offset + len(d.Foods)) } of { view.Itoa(d.Matched) }
		</span>
		<div class="flex items-center" style="margin-left: auto; gap: 8px;">
			<a
				class="licon-btn"
				aria-label="Previous page"
				href={ templ.URL(view.Href(ctx, foodsPageHref(d, d.Page-1))) }
				aria-disabled={ boolAttr(d.Page <= 1) }
			>
				@icons.Icon("chevron-left", 15)
			</a>
			<span class="lmeta">Page { view.Itoa(d.Page) } / { view.Itoa(d.PageCount) }</span>
			<a
				class="licon-btn"
				aria-label="Next page"
				href={ templ.URL(view.Href(ctx, foodsPageHref(d, d.Page+1))) }
				aria-disabled={ boolAttr(d.Page >= d.PageCount) }
			>
				@icons.Icon("chevron-right", 15)
			</a>
		</div>
	</nav>
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
