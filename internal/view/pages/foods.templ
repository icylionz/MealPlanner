package pages

import (
	"net/url"
	"slices"

	"mealplanner/internal/foods"

	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

// foodsFilterHref rebuilds the /foods URL from the active filter state, with the
// given tag dropped from the selection. It backs the removable tag chips so a
// chip can be cleared without JavaScript while keeping every other filter.
func foodsFilterHref(d FoodsData, dropTag string) string {
	q := url.Values{}
	if d.Search != "" {
		q.Set("q", d.Search)
	}
	if d.PrepMin != "" {
		q.Set("prep_min", d.PrepMin)
	}
	if d.PrepMax != "" {
		q.Set("prep_max", d.PrepMax)
	}
	if d.CookMin != "" {
		q.Set("cook_min", d.CookMin)
	}
	if d.CookMax != "" {
		q.Set("cook_max", d.CookMax)
	}
	if d.TagMode == "or" {
		q.Set("tag_mode", "or")
	}
	for _, t := range d.Tags {
		if t != dropTag {
			q.Add("tags", t)
		}
	}
	if enc := q.Encode(); enc != "" {
		return "/foods?" + enc
	}
	return "/foods"
}

// foodsHasFilter reports whether any filter is active, to show a Clear control.
func foodsHasFilter(d FoodsData) bool {
	return d.Search != "" || d.PrepMin != "" || d.PrepMax != "" ||
		d.CookMin != "" || d.CookMax != "" || len(d.Tags) > 0
}

// Foods renders the recipe library screen.
templ Foods(d FoodsData) {
	@layout.Shell("Recipes — Backbone Plate", "foods", d.Member) {
		@layout.PageHeader("Foods & Recipes", "Recipes") {
			if d.Member.IsOwner() {
				<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, "/import")) }>
					@icons.Icon("upload", 14)
					Import
				</a>
				<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/foods/new")) }>
					@icons.Icon("plus", 14)
					New food
				</a>
			}
		}
		<form method="get" action={ templ.URL(view.Href(ctx, "/foods")) } class="page-pad flex flex-col" style="padding: 14px 28px; border-bottom: 1px solid var(--line); background: var(--paper); gap: 12px;">
			// Preserve the current tag selection so each Apply adds the newly
			// picked tag rather than replacing the set (works without JS).
			for _, t := range d.Tags {
				<input type="hidden" name="tags" value={ t }/>
			}
			<div class="flex items-end flex-wrap" style="gap: 12px;">
				<div class="flex-1" style="min-width: 220px; max-width: 340px;">
					@FieldLabel("Search")
					<div class="search-wrap">
						@icons.Icon("search", 14)
						<input class="input input-sm" type="search" name="q" value={ d.Search } placeholder="Name, ingredient, description…"/>
					</div>
				</div>
				<div>
					@FieldLabel("Prep (min)")
					<div class="flex items-center" style="gap: 6px;">
						<input class="input input-sm" type="number" min="0" name="prep_min" value={ d.PrepMin } placeholder="min" style="width: 74px;"/>
						<span style="color: var(--fg-3);">–</span>
						<input class="input input-sm" type="number" min="0" name="prep_max" value={ d.PrepMax } placeholder="max" style="width: 74px;"/>
					</div>
				</div>
				<div>
					@FieldLabel("Cook (min)")
					<div class="flex items-center" style="gap: 6px;">
						<input class="input input-sm" type="number" min="0" name="cook_min" value={ d.CookMin } placeholder="min" style="width: 74px;"/>
						<span style="color: var(--fg-3);">–</span>
						<input class="input input-sm" type="number" min="0" name="cook_max" value={ d.CookMax } placeholder="max" style="width: 74px;"/>
					</div>
				</div>
			</div>
			<div class="flex items-end flex-wrap" style="gap: 12px;">
				<div style="min-width: 200px;">
					@FieldLabel("Add tag")
					<select
						class="select input-sm"
						name="tags"
						data-search-select="1"
						data-search-select-placeholder="Search tags…"
					>
						<option value="" selected></option>
						for _, t := range d.AllTags {
							if !slices.Contains(d.Tags, t) {
								<option value={ t }>{ t }</option>
							}
						}
					</select>
				</div>
				<div>
					@FieldLabel("Match")
					<select class="select input-sm" name="tag_mode">
						<option value="and" selected?={ d.TagMode != "or" }>All tags</option>
						<option value="or" selected?={ d.TagMode == "or" }>Any tag</option>
					</select>
				</div>
				<button type="submit" class="btn btn-sm">Apply</button>
				if foodsHasFilter(d) {
					<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, "/foods")) }>Clear</a>
				}
			</div>
			if len(d.Tags) > 0 {
				<div class="flex flex-wrap items-center" style="gap: 6px;">
					for _, t := range d.Tags {
						<span class="tag tag-accent" style="gap: 5px; padding: 4px 8px;">
							{ t }
							<a class="icon-btn" style="color: var(--accent); padding: 0;" title="Remove tag" href={ templ.URL(view.Href(ctx, foodsFilterHref(d, t))) }>
								@icons.Icon("x", 10)
							</a>
						</span>
					}
				</div>
			}
		</form>
		<div class="page-pad flex-1" style="padding: 20px 28px;">
			if len(d.Foods) == 0 {
				@layout.Empty("utensils", "No foods found", emptyFoodsBody(d.Search)) {
					if d.Member.IsOwner() {
						<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/foods/new")) }>
							@icons.Icon("plus", 14)
							New food
						</a>
					}
				}
			} else {
				<div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px;">
					for _, r := range d.Foods {
						@foodCard(r, d.Member.IsOwner())
					}
				</div>
			}
		</div>
	}
}

func emptyFoodsBody(search string) string {
	if search != "" {
		return "No results for \"" + search + "\"."
	}
	return "Add your first recipe to get started."
}

templ foodCard(r foods.Food, owner bool) {
	<div class="card card-hover flex flex-col" style="gap: 8px;">
		<div class="flex items-start justify-between" style="gap: 8px;">
			<a href={ templ.URL(view.Href(ctx, "/foods/"+r.ID.String())) } style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); line-height: 1.3;">{ r.Name }</a>
			if owner {
				<a href={ templ.URL(view.Href(ctx, "/foods/"+r.ID.String()+"/edit")) } class="icon-btn flex-none" title="Edit food">
					@icons.Icon("pencil", 13)
				</a>
			}
		</div>
		if r.Description != "" {
			<div style="font-size: 12px; color: var(--fg-3); line-height: 1.45; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">{ r.Description }</div>
		}
		@RecipeTags(r.Tags, 4)
		<div class="flex items-center" style="border-top: 1px solid var(--line); padding-top: 8px; gap: 14px;">
			if r.PrepTime+r.CookTime > 0 {
				<span class="flex items-center overline" style="gap: 4px; letter-spacing: .05em;">
					@icons.Icon("clock", 12)
					{ view.Itoa(r.PrepTime + r.CookTime) } min
				</span>
			}
			<span class="flex items-center overline" style="gap: 4px; letter-spacing: .05em;">
				@icons.Icon("list", 12)
				{ view.Itoa(len(r.Components)) } comp.
			</span>
			if SubCount(r) > 0 {
				<span class="flex items-center overline" style="gap: 4px; letter-spacing: .05em; color: var(--accent);">
					@icons.Icon("layers", 12)
					{ view.Itoa(SubCount(r)) } sub
				</span>
			}
			<span class="overline" style="margin-left: auto; letter-spacing: .05em;">× { view.Itoa(r.Servings) }</span>
		</div>
	</div>
}
