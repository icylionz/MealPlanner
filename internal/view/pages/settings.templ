package pages

import (
	"mealplanner/internal/view"
	"mealplanner/internal/view/layout"
)

// Settings renders the account settings screen: profile (name/email) and
// password change, each an independently-submitted form.
templ Settings(d SettingsData) {
	@layout.Shell("Settings — Backbone Plate", "settings", d.Member) {
		@layout.PageHeader("Account", "Settings") {
		}
		<div class="page-pad flex-1">
			<!-- Profile -->
			<div class="card" style="max-width: 420px; padding: 18px; margin-bottom: 24px;">
				<div style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px;">Profile</div>
				<div style="font-size: 12px; color: var(--fg-3); margin-bottom: 14px;">Your display name and sign-in email.</div>
				if d.ProfileSaved {
					<div class="settings-ok">Profile updated.</div>
				}
				if d.ProfileError != "" {
					<div class="auth-error">{ d.ProfileError }</div>
				}
				<form method="post" action={ templ.URL(view.Href(ctx, "/settings/profile")) } class="flex flex-col" style="gap: 12px;">
					<label class="auth-label">
						Name
						<input class="input" type="text" name="name" value={ d.Account.Name } autocomplete="name" required/>
					</label>
					<label class="auth-label">
						Email
						<input class="input" type="email" name="email" value={ d.Account.Email } autocomplete="username" required/>
					</label>
					<button type="submit" class="btn btn-sm" style="align-self: flex-start;">Save profile</button>
				</form>
			</div>
			<!-- Password -->
			<div class="card" style="max-width: 420px; padding: 18px;">
				<div style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px;">Password</div>
				<div style="font-size: 12px; color: var(--fg-3); margin-bottom: 14px;">Change the password you use to sign in.</div>
				if d.PasswordSaved {
					<div class="settings-ok">Password changed.</div>
				}
				if d.PasswordError != "" {
					<div class="auth-error">{ d.PasswordError }</div>
				}
				<form method="post" action={ templ.URL(view.Href(ctx, "/settings/password")) } class="flex flex-col" style="gap: 12px;">
					<label class="auth-label">
						Current password
						<input class="input" type="password" name="current" autocomplete="current-password" required/>
					</label>
					<label class="auth-label">
						New password
						<input class="input" type="password" name="next" autocomplete="new-password" minlength="8" required/>
						<span class="auth-hint">At least 8 characters.</span>
					</label>
					<button type="submit" class="btn btn-sm" style="align-self: flex-start;">Change password</button>
				</form>
			</div>
		</div>
	}
}
