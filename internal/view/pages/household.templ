package pages

import (
	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

// Household renders the household members screen for the active household.
templ Household(d HouseholdData) {
	@layout.Shell("Household — Backbone Plate", "household", d.Member) {
		@layout.PageHeader("Household", d.Household.Name) {
			if d.Member.Role == "owner" {
				<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/household?invite=1")) }>
					@icons.Icon("plus", 14)
					Add member
				</a>
			}
		}
		<div class="page-pad flex-1">
			if d.Error != "" {
				<div class="auth-error" style="max-width: 420px;">{ d.Error }</div>
			}
			<div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; margin-bottom: 24px;">
				for _, m := range d.Members {
					<div class="card" style={ memberCardStyle(d, m.AccountID.String()) }>
						<div class="flex flex-col items-center text-center" style="gap: 10px; padding: 4px;">
							<div style="position: relative;">
								@layout.Avatar(m.Initials, m.Color, 56)
								if isCurrent(d, m.AccountID.String()) {
									<div style="position: absolute; bottom: -2px; right: -2px; width: 16px; height: 16px; border-radius: 50%; background: var(--success); border: 2px solid var(--paper); display: flex; align-items: center; justify-content: center; color: #fff;">
										@icons.Icon("check", 8)
									</div>
								}
							</div>
							<div>
								<div style="font-family: var(--font-display); font-weight: 700; font-size: 17px; color: var(--ink);">{ m.Name }</div>
								<div style="font-size: 12px; color: var(--fg-3);">{ m.Email }</div>
								if isCurrent(d, m.AccountID.String()) {
									@layout.TagAccent(m.Role)
								} else {
									@layout.Tag(m.Role)
								}
							</div>
							if m.Role != "owner" && d.Member.Role == "owner" {
								<form method="post" action={ templ.URL(view.Href(ctx, "/household/remove?member="+m.AccountID.String())) }>
									<button type="submit" class="icon-btn icon-btn-danger flex items-center" style="font-size: 12px; gap: 4px;">
										@icons.Icon("trash-2", 12)
										Remove
									</button>
								</form>
							}
						</div>
					</div>
				}
			</div>
			if d.ShowInvite && d.Member.Role == "owner" {
				<div class="card" style="max-width: 420px; padding: 18px; margin-bottom: 24px;">
					<div style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 12px;">Add an existing member by email</div>
					<form method="post" action={ templ.URL(view.Href(ctx, "/household/members")) } class="flex" style="gap: 8px;">
						<input class="input flex-1" name="email" type="email" placeholder="name@example.com" autofocus required/>
						<button type="submit" class="btn btn-sm">Add</button>
						<a class="btn btn-ghost btn-sm" href={ templ.URL(view.Href(ctx, "/household")) }>Cancel</a>
					</form>
					<div style="font-size: 12px; color: var(--fg-4); margin-top: 8px;">They must already have a Backbone Plate account.</div>
				</div>
			}
			<!-- Invite code -->
			<div class="card" style="max-width: 420px; padding: 18px; margin-bottom: 24px;">
				<div style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 4px;">Invite code</div>
				<div style="font-size: 12px; color: var(--fg-3); margin-bottom: 12px;">Share this code so others can join this household.</div>
				<div class="flex items-center" style="gap: 12px;">
					<span class="invite-code">{ d.Household.InviteCode }</span>
					if d.Member.Role == "owner" {
						<form method="post" action={ templ.URL(view.Href(ctx, "/household/invite/regenerate")) }>
							<button type="submit" class="btn btn-ghost btn-xs flex items-center" style="gap: 4px;">
								@icons.Icon("refresh", 12)
								Regenerate
							</button>
						</form>
					}
				</div>
			</div>
			if len(d.Households) > 1 {
				<div class="card" style="max-width: 420px; padding: 18px;">
					<div style="font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--ink); margin-bottom: 12px;">Switch household</div>
					<div class="flex flex-col" style="gap: 8px;">
						for _, h := range d.Households {
							if h.ID != d.Household.ID {
								<form method="post" action={ templ.URL(view.Href(ctx, "/households/switch")) }>
									<input type="hidden" name="household" value={ h.ID.String() }/>
									<button type="submit" class="btn btn-secondary btn-sm" style="width: 100%; justify-content: space-between;">
										{ h.Name }
										<span style="font-size: 12px; opacity: .7;">Switch →</span>
									</button>
								</form>
							}
						}
					</div>
				</div>
			}
		</div>
	}
}

func isCurrent(d HouseholdData, accountID string) bool {
	return d.Member != nil && d.Member.AccountID.String() == accountID
}

func memberCardStyle(d HouseholdData, accountID string) string {
	if isCurrent(d, accountID) {
		return "padding: 20px; border: 1.5px solid var(--accent-tint-2);"
	}
	return "padding: 20px;"
}
