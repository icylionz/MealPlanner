package pages

import (
	"net/url"
	"strings"

	"mealplanner/internal/view"
	"mealplanner/internal/view/icons"
	"mealplanner/internal/view/layout"
)

// withParam returns baseURL (path?query) with one query key replaced.
func withParam(baseURL, key, value string) string {
	path := baseURL
	query := ""
	if i := strings.IndexByte(baseURL, '?'); i >= 0 {
		path, query = baseURL[:i], baseURL[i+1:]
	}
	q, _ := url.ParseQuery(query)
	q.Set(key, value)
	return path + "?" + q.Encode()
}

// FoodDetail renders the food detail screen.
templ FoodDetail(d FoodDetailData) {
	@layout.Shell(d.Food.Name+" — Backbone Plate", "foods", d.Member) {
		@layout.PageHeaderBack("/foods", "Foods & recipes", d.Food.Name) {
			if d.Member.IsOwner() {
				<a class="btn btn-secondary btn-sm" href={ templ.URL(view.Href(ctx, "/foods/"+d.Food.ID.String()+"/edit")) }>
					@icons.Icon("pencil", 14)
					Edit
				</a>
				<a class="btn btn-sm" href={ templ.URL(view.Href(ctx, "/meals/new?food="+d.Food.ID.String()+"&return=/foods/"+d.Food.ID.String())) }>
					@icons.Icon("calendar", 14)
					Add to plan
				</a>
			}
		}
		<div class="page-pad flex-1" style="max-width: 760px;">
			<div class="flex items-center flex-wrap" style="gap: 8px; margin-bottom: 14px;">
				for _, t := range d.Food.Tags {
					@layout.TagAccent(t)
				}
				if d.Food.PrepTime > 0 {
					@layout.Tag(view.Itoa(d.Food.PrepTime) + " min prep")
				}
				if d.Food.CookTime > 0 {
					@layout.Tag(view.Itoa(d.Food.CookTime) + " min cook")
				}
				if d.Food.IsRecipe() {
					@layout.Tag("serves " + view.Itoa(d.Food.Servings))
				} else {
					@layout.Tag("raw ingredient")
				}
				if d.Food.HasDensity() {
					if d.Food.DensitySource == "custom" {
						@layout.TagAccent(FormatDensity(d.Food.Density) + " g/ml · custom")
					} else {
						@layout.Tag(FormatDensity(d.Food.Density) + " g/ml")
					}
				}
			</div>
			if d.Food.Description != "" {
				<p style="font-size: 14px; color: var(--fg-2); line-height: 1.6; margin: 0 0 20px;">{ d.Food.Description }</p>
			}
			if len(d.Food.Aliases) > 0 {
				<div class="flex items-center flex-wrap" style="gap: 6px; margin-bottom: 20px;">
					<span class="overline" style="margin-right: 2px;">Also known as</span>
					for _, alias := range d.Food.Aliases {
						@layout.Tag(alias)
					}
				</div>
			}
			if d.Food.SourceURL != "" {
				<div class="card flex items-center" style="gap: 10px; padding: 12px 14px; margin-bottom: 20px;">
					<div class="flex-1 min-w-0">
						<div class="overline" style="margin-bottom: 3px;">Imported source</div>
						if view.IsExternalURL(d.Food.SourceURL) {
							<a href={ d.Food.SourceURL } rel="noopener noreferrer" style="font-size: 13px; color: var(--accent); overflow-wrap: anywhere;">{ d.Food.SourceURL }</a>
						} else {
							<div style="font-size: 13px; color: var(--fg-3); overflow-wrap: anywhere;">{ d.Food.SourceURL }</div>
						}
						if d.Food.SourceLastImportedAt != nil {
							<div style="font-size: 11px; color: var(--fg-4); margin-top: 3px;">Last imported { d.Food.SourceLastImportedAt.UTC().Format("2 Jan 2006 15:04 UTC") }</div>
						}
					</div>
					if d.Member.IsOwner() && view.IsExternalURL(d.Food.SourceURL) {
						<form method="post" action={ templ.URL(view.Href(ctx, "/foods/"+d.Food.ID.String()+"/reimport")) }>
							<button class="btn btn-secondary btn-sm" type="submit">Re-import</button>
						</form>
					}
				</div>
			}
			if d.Food.IsRecipe() {
				<div style="margin-bottom: 22px;">
					<div class="overline" style="letter-spacing: .08em; margin-bottom: 8px;">Scale</div>
					<div class="flex" style="gap: 6px;">
						for _, m := range []int{1, 2, 3, 4} {
							<a
								href={ templ.URL(view.Href(ctx, withParam(d.BaseURL, "scale", view.Itoa(m)))) }
								class={ "chip", templ.KV("active", d.Scale == m) }
								style="border-radius: var(--radius-sm); padding: 6px 14px; font-weight: 700; font-size: 13px;"
							>×{ view.Itoa(m) }</a>
						}
						<span class="flex items-center" style="margin-left: 6px; font-size: 13px; color: var(--fg-3);">
							= { view.Itoa(d.Food.Servings * d.Scale) } { view.Plural(d.Food.Servings*d.Scale, "serving", "servings") }
						</span>
					</div>
				</div>
				<section style="margin-bottom: 28px;">
					<div class="overline" style="letter-spacing: .08em; margin-bottom: 10px;">Components</div>
					<div class="ing-tree">
						@ingredientNodes(d, d.Tree)
					</div>
				</section>
			}
			if len(d.Food.Steps) > 0 {
				<section style="margin-bottom: 28px;">
					<div class="overline" style="letter-spacing: .08em; margin-bottom: 10px;">Steps</div>
					<ol class="flex flex-col" style="margin: 0; padding: 0; list-style: none; gap: 8px;">
						for i, s := range d.Food.Steps {
							<li class="flex items-start" style="gap: 12px;">
								<span class="step-num" style="padding-top: 2px;">{ stepNum(i) }</span>
								<span style="font-size: 14px; color: var(--fg-2); line-height: 1.55;">{ s }</span>
							</li>
						}
					</ol>
				</section>
			}
		</div>
	}
}

func stepNum(i int) string {
	n := view.Itoa(i + 1)
	if len(n) == 1 {
		return "0" + n
	}
	return n
}

templ ingredientNodes(d FoodDetailData, nodes []IngNode) {
	for _, n := range nodes {
		@ingredientNode(d, n)
	}
}

templ ingredientNode(d FoodDetailData, n IngNode) {
	if n.SubFood != nil {
		<details>
			<summary class={ "ing-row", templ.KV("ing-sub", n.Depth > 0) } style={ ingIndent(n.Depth) }>
				<span class="chev" style="color: var(--accent); display: flex;">
					@icons.Icon("chevron-right", 13)
				</span>
				<span class="flex-1" style="font-weight: 600; font-size: 14px; color: var(--accent-strong);">
					{ n.SubFood.Name }
					if n.Component.Variant != "" {
						<span style="font-weight: 400; color: var(--fg-3);">, { n.Component.Variant }</span>
					}
				</span>
				<span style="font-size: 12px; color: var(--fg-3);">{ FormatAmount(n.Amount) } { n.Component.Unit }</span>
				<a href={ templ.URL(view.Href(ctx, "/foods/"+n.SubFood.ID.String())) } class="icon-btn" title="View food">
					@icons.Icon("link", 12)
				</a>
				@layout.TagAccent("recipe")
			</summary>
			@ingredientNodes(d, n.Children)
		</details>
	} else {
		<div class={ "ing-row", templ.KV("ing-sub", n.Depth > 0) } style={ ingIndent(n.Depth) }>
			<span class="ing-dot"></span>
			<a href={ templ.URL(view.Href(ctx, "/foods/"+n.Component.ChildFoodID.String())) } class="flex-1" style="font-size: 14px; color: var(--ink);">
				{ n.Component.Name }
				if n.Component.Variant != "" {
					<span style="color: var(--fg-3);">, { n.Component.Variant }</span>
				}
			</a>
			@UnitTagLinks(n.Amount, n.Unit, false, ConvertOptionsFor(n.Amount, n.Unit), func(u string) string {
				return withParam(d.BaseURL, n.ConvertKey, u)
			})
		</div>
	}
}

func ingIndent(depth int) string {
	return "padding-left: " + view.Itoa(14+depth*20) + "px;"
}
