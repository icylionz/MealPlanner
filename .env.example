# Meals configuration (copy to .env)
PORT=8080
BASE_PATH=
DATABASE_URL=postgres://mealplanner:mealplanner@localhost:5432/mealplanner?sslmode=disable
SESSION_COOKIE_NAME=mealplanner_session
SESSION_SECRET=change-me
APP_ENV=development
APP_TIMEZONE=UTC
LOGIN_THROTTLE_THRESHOLD=5
LOGIN_THROTTLE_WINDOW=10m
LOGIN_THROTTLE_BLOCK_DURATION=15m
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Empty uses the direct peer.
TRUSTED_PROXY_CIDRS=
# Household gateway endpoint for the shared theme, called as GET <url>?user=<email>. Empty keeps the built-in theme.
HOUSEHOLD_THEME_URL=
